%% eija: source: pydantic models in eija_studio.domain (frozen, extra=forbid)
classDiagram
    direction LR
    class Alternative {
        <<value-object>>
        +str interpretation
        +str explanation
    }
    class ChangeCase {
        <<aggregate-root>>
        +str id
        +int version
        +Literal~DRAFT|PROPOSED|PREVIEW|SAVED|VERIFIED|APPROVED|APPLIED|DISCARDED~ stage
        +str request
        +int baseline_version
        +dict~str, Any~ | None provider_run
        +str | None selected_meaning
        +str | None selected_by
        +tuple~AddState | AddTransition | RemoveState | RemoveTransition | RenameState | RetargetTransition | SetEffects | SetGuards | SetInitial | SetRole~ transactions
        +tuple~AddState | AddTransition | RemoveState | RemoveTransition | RenameState | RetargetTransition | SetEffects | SetGuards | SetInitial | SetRole~ redo_transactions
        +dict~str, dict~str, int~~ layout
        +tuple~dict~str, Any~~ receipts
        +dict~str, Any~ | None decision
        +str created_at
    }
    class ExecuteCommand {
        <<command>>
        +str operation_id
        +str actor_id
        +str instance_id
        +str action
        +int expected_version
    }
    class LayoutChange {
        <<command>>
        +str node
        +int x
        +int y
    }
    class Principal {
        <<value-object>>
        +str id
        +frozenset~str~ capabilities
    }
    class Proposal {
        <<value-object>>
        +str summary
        +tuple~str~ unknowns
    }
    class Transition {
        <<value-object>>
        +str id
        +str action
        +str from_state
        +str to_state
        +str role
        +tuple~str~ required_effects
        +tuple~str~ forbidden_effects
    }
    class Workflow {
        <<value-object>>
        +Literal~eija.workflow.v1~ schema_version
        +str id
        +str initial_state
        +tuple~str~ states
    }
    class Guard {
        <<enumeration>>
        actor_active
        role_current
        actor_assigned
        state_equals
        expected_version
        operation_binding
    }
    ChangeCase "1" *-- "0..1" Proposal : proposal
    ChangeCase "1" *-- "1" Workflow : baseline
    ChangeCase "1" *-- "0..1" Workflow : candidate
    Proposal "1" *-- "1..*" Alternative : alternatives
    Transition "1" --> "*" Guard : guards
    Workflow "1" *-- "1..*" Transition : transitions
