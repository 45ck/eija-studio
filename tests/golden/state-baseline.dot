// eija: baseline: workflow excursion semantic_hash=5d3ef3a19c31d956a185b9c5ba4b1b79e651d0356e162436c5c67054d2ad4cdf
digraph "excursion state machine" {
    rankdir=TB;
    graph [fontname="Helvetica"];
    node [shape=box, fontname="Helvetica", margin="0.15,0.08"];
    edge [fontname="Helvetica", fontsize=10];
    "__start" [shape=point, width=0.15, label=""];
    "__start" -> "Draft";
    "__end" [shape=doublecircle, width=0.2, label="", style=filled, fillcolor="#1f2328"];
    "Approved" [label="Approved", fillcolor="#f6f8fa", color="#57606a", fontcolor="#1f2328", style="rounded,filled"]
    "Draft" [label="Draft", fillcolor="#f6f8fa", color="#57606a", fontcolor="#1f2328", style="rounded,filled"]
    "Rejected" [label="Rejected", fillcolor="#f6f8fa", color="#57606a", fontcolor="#1f2328", style="rounded,filled"]
    "Submitted" [label="Submitted", fillcolor="#f6f8fa", color="#57606a", fontcolor="#1f2328", style="rounded,filled"]
    "Draft" -> "Submitted" [color="#57606a", label="Submit · Teacher"]
    "Rejected" -> "Draft" [color="#57606a", label="Revise · Teacher"]
    "Submitted" -> "Approved" [color="#57606a", label="Approve · Registrar"]
    "Submitted" -> "Rejected" [color="#57606a", label="Reject · Registrar"]
    "Approved" -> "__end";
}
