{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/45ck/eija-studio/graph/schema/rules.schema.json",
  "title": "EIJA weave rule system records (ADR-0095)",
  "description": "Structural schema for graph/rules/catalogue.json, findings, suppressions, baselines and ADR-lite decision entries. Semantic checks (strata, relation names, metamodel agreement, fixture obligations) are in graph/rules/check_catalogue.py; this file checks shape only.",
  "$defs": {
    "ruleId": {"type": "string", "pattern": "^WV-[0-9]{3}$"},
    "messageId": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
    "argName": {"type": "string", "pattern": "^[a-z][a-z0-9_]*$"},
    "fingerprint": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
    "repoId": {"type": "string", "pattern": "^repo://"},
    "level": {"enum": ["error", "warning", "note", "notrun"]},
    "message": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "level", "text"],
      "properties": {
        "id": {"$ref": "#/$defs/messageId"},
        "level": {"$ref": "#/$defs/level"},
        "text": {"type": "string", "minLength": 1}
      }
    },
    "fix": {
      "type": ["object", "null"],
      "additionalProperties": false,
      "required": ["applicability", "what"],
      "properties": {
        "applicability": {"enum": ["machine_applicable", "maybe_incorrect", "has_placeholders", "human_only"]},
        "what": {"type": "string", "minLength": 1}
      }
    },
    "rule": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "name", "category", "class", "kind", "implementation", "template", "params", "reads", "stratum", "severity", "tier", "phase", "maturity", "soundness", "statement", "witness", "messages", "args", "subjects", "identity_args", "why", "false_positive_control", "fix", "not_run_when", "mutations", "tool_backed", "depends_on_adr", "metamodel", "sources", "brief_id"],
      "properties": {
        "id": {"$ref": "#/$defs/ruleId"},
        "name": {"type": "string", "pattern": "^[a-z][a-z0-9-]*$"},
        "category": {"type": "string"},
        "class": {"enum": ["compile", "lint"]},
        "kind": {"enum": ["file-local", "graph-global", "template", "adapter", "rendered", "harness", "test-level", "meta"]},
        "implementation": {"type": "string", "pattern": "^(sql|python|tool:[a-z+]+)$"},
        "template": {"enum": ["cardinality-min", "cardinality-max", "acyclic", null]},
        "params": {"type": ["object", "null"]},
        "reads": {
          "type": "object",
          "additionalProperties": false,
          "required": ["pos", "neg"],
          "properties": {
            "pos": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
            "neg": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
          }
        },
        "stratum": {"type": "integer", "minimum": 0, "maximum": 3},
        "severity": {"$ref": "#/$defs/level"},
        "tier": {"enum": ["fast", "full", "release"]},
        "phase": {"enum": ["P1", "P2", "P3", "P4"]},
        "maturity": {"enum": ["proposed", "experimental", "enforced", "deprecated"]},
        "soundness": {"enum": ["exact", "may", "heuristic"]},
        "statement": {"type": "string", "minLength": 1},
        "witness": {
          "type": "object",
          "additionalProperties": false,
          "required": ["kind", "detail"],
          "properties": {
            "kind": {"enum": ["single", "pair", "path", "scope", "diff", "counterexample"]},
            "detail": {"type": "string"}
          }
        },
        "messages": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/message"}},
        "args": {"type": "array", "items": {"$ref": "#/$defs/argName"}, "uniqueItems": true},
        "subjects": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/argName"}},
        "identity_args": {"type": "array", "items": {"$ref": "#/$defs/argName"}},
        "why": {"type": "string", "minLength": 1},
        "false_positive_control": {"type": "string", "minLength": 1},
        "fix": {"$ref": "#/$defs/fix"},
        "not_run_when": {"type": ["string", "null"]},
        "mutations": {
          "type": "object",
          "additionalProperties": false,
          "required": ["fire", "repair", "benign"],
          "properties": {
            "fire": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^FM-"}},
            "repair": {"type": "array", "minItems": 1, "items": {"type": "string", "pattern": "^RM-"}},
            "benign": {"type": "array", "items": {"type": "string", "pattern": "^BM-"}}
          }
        },
        "tool_backed": {"type": ["object", "null"]},
        "depends_on_adr": {"type": "array", "items": {"type": "string", "pattern": "^[0-9]{4}$"}},
        "metamodel": {"type": ["string", "null"]},
        "sources": {"type": "array", "items": {"type": "string"}},
        "brief_id": {"type": ["string", "null"]}
      }
    },
    "catalogue": {
      "type": "object",
      "required": ["schema", "date", "status", "categories", "kinds", "severities", "tiers", "strata", "relations", "mutation_operators", "banned_apis", "rules", "retired", "derivations", "verdicts"],
      "properties": {
        "schema": {"const": "eija.weave.rules/v1"},
        "rules": {"type": "array", "minItems": 40, "items": {"$ref": "#/$defs/rule"}},
        "retired": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["id", "name", "merged_into", "reason"],
            "properties": {"id": {"$ref": "#/$defs/ruleId"}, "name": {"type": "string"}, "merged_into": {"$ref": "#/$defs/ruleId"}, "reason": {"type": "string"}}
          }
        }
      }
    },
    "finding": {
      "description": "The Finding record before SARIF serialisation (rules.md section 5). Everything an agent needs is structured; nothing is parsed from prose.",
      "type": "object",
      "additionalProperties": false,
      "required": ["rule", "message_id", "level", "args", "subjects", "fingerprint", "locations", "witness"],
      "properties": {
        "rule": {"$ref": "#/$defs/ruleId"},
        "message_id": {"$ref": "#/$defs/messageId"},
        "level": {"enum": ["error", "warning", "note"]},
        "args": {"type": "object", "additionalProperties": {"type": ["string", "integer", "boolean"]}},
        "subjects": {"type": "array", "minItems": 1, "items": {"type": "string"}},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "locations": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {"id": {"$ref": "#/$defs/repoId"}, "path": {"type": "string"}, "line": {"type": "integer", "minimum": 1}}
          }
        },
        "witness": {"type": "array", "items": {"type": "object", "required": ["id", "text"], "properties": {"id": {"type": "string"}, "text": {"type": "string"}}}},
        "fix": {"type": ["object", "null"]},
        "related": {"type": "array", "items": {"$ref": "#/$defs/fingerprint"}}
      }
    },
    "suppression": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "rule", "fingerprint", "justification", "evidence", "expires"],
      "properties": {
        "id": {"type": "string", "pattern": "^S-[0-9]{4}$"},
        "rule": {"$ref": "#/$defs/ruleId"},
        "fingerprint": {"$ref": "#/$defs/fingerprint"},
        "justification": {"type": "string", "minLength": 10},
        "evidence": {"type": "string", "description": "repo-relative path, optionally with #anchor, that must resolve"},
        "expires": {
          "oneOf": [
            {"type": "object", "additionalProperties": false, "required": ["ledger_seq"], "properties": {"ledger_seq": {"type": "integer", "minimum": 1}}},
            {"type": "object", "additionalProperties": false, "required": ["release"], "properties": {"release": {"type": "string"}}},
            {"type": "object", "additionalProperties": false, "required": ["until_digest", "subject"], "properties": {"until_digest": {"type": "string", "pattern": "^sha256:[0-9a-f]{64}$"}, "subject": {"$ref": "#/$defs/repoId"}}},
            {"type": "object", "additionalProperties": false, "required": ["as_of"], "properties": {"as_of": {"type": "string", "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"}}}
          ]
        }
      }
    },
    "baseline": {
      "type": "object",
      "additionalProperties": false,
      "required": ["schema", "entries"],
      "properties": {
        "schema": {"const": "eija.weave.baseline/v1"},
        "entries": {"type": "array", "items": {"type": "object", "additionalProperties": false, "required": ["fingerprint", "rule"], "properties": {"fingerprint": {"$ref": "#/$defs/fingerprint"}, "rule": {"$ref": "#/$defs/ruleId"}}}}
      }
    },
    "decision_entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["seq", "rule", "action", "adr", "maturity", "problem", "evidence", "alternatives", "alternatives_checked", "cost", "revisit"],
      "properties": {
        "seq": {"type": "integer", "minimum": 1},
        "rule": {"$ref": "#/$defs/ruleId"},
        "action": {"enum": ["propose", "experimental", "enforce", "change-severity", "change-messages", "deprecate", "retire"]},
        "adr": {"type": "string", "pattern": "^[0-9]{4}$"},
        "maturity": {"enum": ["proposed", "experimental", "enforced", "deprecated"]},
        "problem": {"type": "string"},
        "evidence": {"type": "array", "items": {"type": "string"}},
        "alternatives": {"type": "string"},
        "alternatives_checked": {"type": "boolean"},
        "cost": {"type": "string"},
        "revisit": {"type": "string"}
      }
    }
  },
  "oneOf": [
    {"$ref": "#/$defs/catalogue"}
  ]
}
