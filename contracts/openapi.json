  "components": {
    "schemas": {
      "Approval": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "subject_hash": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$",
            "title": "Subject Hash"
          },
          "answers": {
            "additionalProperties": {
              "type": "string"
            },
            "type": "object",
            "title": "Answers"
          },
          "acknowledge_unknowns": {
            "type": "boolean",
            "title": "Acknowledge Unknowns"
          },
          "scope": {
            "type": "string",
            "enum": [
              "local-demo",
              "field-use"
            ],
            "title": "Scope",
            "default": "local-demo"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "subject_hash",
          "answers",
          "acknowledge_unknowns"
        ],
        "title": "Approval"
      },
      "Edit": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "transaction": {
            "$ref": "#/components/schemas/SemanticTransaction"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "transaction"
        ],
        "title": "Edit"
      },
      "ExecuteCommand": {
        "properties": {
          "operation_id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,100}$",
            "title": "Operation Id"
          },
          "actor_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Actor Id"
          },
          "instance_id": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Instance Id"
          },
          "action": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Action"
          },
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "operation_id",
          "actor_id",
          "instance_id",
          "action",
          "expected_version"
        ],
        "title": "ExecuteCommand"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "Layout": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "change": {
            "$ref": "#/components/schemas/LayoutChange"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "change"
        ],
        "title": "Layout"
      },
      "LayoutChange": {
        "properties": {
          "node": {
            "type": "string",
            "maxLength": 60,
            "minLength": 1,
            "title": "Node"
          },
          "x": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "X"
          },
          "y": {
            "type": "integer",
            "maximum": 2000.0,
            "minimum": 0.0,
            "title": "Y"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "node",
          "x",
          "y"
        ],
        "title": "LayoutChange"
      },
      "NewCase": {
        "properties": {
          "request": {
            "type": "string",
            "maxLength": 6000,
            "minLength": 1,
            "title": "Request"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "request"
        ],
        "title": "NewCase"
      },
      "Preview": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "state": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "State"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "Preview"
      },
      "Propose": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "consent": {
            "type": "boolean",
            "title": "Consent",
            "default": false
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "Propose"
      },
      "Select": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          },
          "interpretation": {
            "type": "string",
            "enum": [
              "recommend_only",
              "final_approval",
              "confirm_only",
              "unsupported"
            ],
            "title": "Interpretation"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version",
          "interpretation"
        ],
        "title": "Select"
      },
      "SemanticTransaction": {
        "properties": {
          "kind": {
            "type": "string",
            "enum": [
              "enable_recommendation",
              "set_rejection_source"
            ],
            "title": "Kind"
          },
          "rejection_source": {
            "type": "string",
            "enum": [
              "Submitted",
              "Recommended"
            ],
            "title": "Rejection Source",
            "default": "Recommended"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind"
        ],
        "title": "SemanticTransaction"
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      },
      "Version": {
        "properties": {
          "expected_version": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Expected Version"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "expected_version"
        ],
        "title": "Version"
      }
    }
  }
}
