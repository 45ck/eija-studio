{
  "$defs": {
    "AddState": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "add_state",
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "State",
          "type": "string"
        },
        "after": {
          "anyOf": [
            {
              "maxLength": 60,
              "minLength": 1,
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "After"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "title": "AddState",
      "type": "object"
    },
    "AddTransition": {
      "additionalProperties": false,
      "description": "A transition performing a declared action; its guards and effects are the action's declared ones.",
      "properties": {
        "kind": {
          "const": "add_transition",
          "title": "Kind",
          "type": "string"
        },
        "id": {
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "action": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "from_state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "From State",
          "type": "string"
        },
        "to_state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "To State",
          "type": "string"
        },
        "role": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "id",
        "action",
        "from_state",
        "to_state",
        "role"
      ],
      "title": "AddTransition",
      "type": "object"
    },
    "Alternative": {
      "additionalProperties": false,
      "properties": {
        "interpretation": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Interpretation",
          "type": "string"
        },
        "explanation": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Explanation",
          "type": "string"
        }
      },
      "required": [
        "interpretation",
        "explanation"
      ],
      "title": "Alternative",
      "type": "object"
    },
    "Proposal": {
      "additionalProperties": false,
      "properties": {
        "summary": {
          "maxLength": 1600,
          "minLength": 1,
          "title": "Summary",
          "type": "string"
        },
        "alternatives": {
          "items": {
            "$ref": "#/$defs/Alternative"
          },
          "maxItems": 4,
          "minItems": 1,
          "title": "Alternatives",
          "type": "array"
        },
        "unknowns": {
          "items": {
            "type": "string"
          },
          "maxItems": 10,
          "title": "Unknowns",
          "type": "array"
        }
      },
      "required": [
        "summary",
        "alternatives",
        "unknowns"
      ],
      "title": "Proposal",
      "type": "object"
    },
    "RemoveState": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remove_state",
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "title": "RemoveState",
      "type": "object"
    },
    "RemoveTransition": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "remove_transition",
          "title": "Kind",
          "type": "string"
        },
        "transition": {
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
          "title": "Transition",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "transition"
      ],
      "title": "RemoveTransition",
      "type": "object"
    },
    "RenameState": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "rename_state",
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "State",
          "type": "string"
        },
        "to": {
          "maxLength": 60,
          "minLength": 1,
          "title": "To",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "state",
        "to"
      ],
      "title": "RenameState",
      "type": "object"
    },
    "RetargetTransition": {
      "additionalProperties": false,
      "description": "Move one end of a transition to another state (the drag-and-drop edit).",
      "properties": {
        "kind": {
          "const": "retarget_transition",
          "title": "Kind",
          "type": "string"
        },
        "transition": {
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
          "title": "Transition",
          "type": "string"
        },
        "end": {
          "enum": [
            "source",
            "target"
          ],
          "title": "End",
          "type": "string"
        },
        "state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "transition",
        "end",
        "state"
      ],
      "title": "RetargetTransition",
      "type": "object"
    },
    "SetEffects": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "set_effects",
          "title": "Kind",
          "type": "string"
        },
        "transition": {
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
          "title": "Transition",
          "type": "string"
        },
        "required_effects": {
          "items": {
            "maxLength": 60,
            "minLength": 1,
            "type": "string"
          },
          "maxItems": 16,
          "title": "Required Effects",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "transition",
        "required_effects"
      ],
      "title": "SetEffects",
      "type": "object"
    },
    "SetGuards": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "set_guards",
          "title": "Kind",
          "type": "string"
        },
        "transition": {
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
          "title": "Transition",
          "type": "string"
        },
        "guards": {
          "items": {
            "enum": [
              "actor_active",
              "role_current",
              "actor_assigned",
              "state_equals",
              "expected_version",
              "operation_binding"
            ],
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "Guards",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "transition",
        "guards"
      ],
      "title": "SetGuards",
      "type": "object"
    },
    "SetInitial": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "set_initial",
          "title": "Kind",
          "type": "string"
        },
        "state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "State",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "state"
      ],
      "title": "SetInitial",
      "type": "object"
    },
    "SetRole": {
      "additionalProperties": false,
      "properties": {
        "kind": {
          "const": "set_role",
          "title": "Kind",
          "type": "string"
        },
        "transition": {
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
          "title": "Transition",
          "type": "string"
        },
        "role": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        }
      },
      "required": [
        "kind",
        "transition",
        "role"
      ],
      "title": "SetRole",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "action": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "from_state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "From State",
          "type": "string"
        },
        "to_state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "To State",
          "type": "string"
        },
        "role": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "guards": {
          "items": {
            "enum": [
              "actor_active",
              "role_current",
              "actor_assigned",
              "state_equals",
              "expected_version",
              "operation_binding"
            ],
            "type": "string"
          },
          "title": "Guards",
          "type": "array"
        },
        "required_effects": {
          "items": {
            "type": "string"
          },
          "title": "Required Effects",
          "type": "array"
        },
        "forbidden_effects": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Effects",
          "type": "array"
        }
      },
      "required": [
        "id",
        "action",
        "from_state",
        "to_state",
        "role",
        "guards",
        "required_effects",
        "forbidden_effects"
      ],
      "title": "Transition",
      "type": "object"
    },
    "Workflow": {
      "additionalProperties": false,
      "properties": {
        "schema_version": {
          "const": "eija.workflow.v1",
          "default": "eija.workflow.v1",
          "title": "Schema Version",
          "type": "string"
        },
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "initial_state": {
          "title": "Initial State",
          "type": "string"
        },
        "states": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "States",
          "type": "array"
        },
        "transitions": {
          "items": {
            "$ref": "#/$defs/Transition"
          },
          "maxItems": 64,
          "minItems": 1,
          "title": "Transitions",
          "type": "array"
        }
      },
      "required": [
        "id",
        "initial_state",
        "states",
        "transitions"
      ],
      "title": "Workflow",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "description": "Aggregate boundary: transitions are mediated by the application and CAS store.",
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "version": {
      "title": "Version",
      "type": "integer"
    },
    "stage": {
      "enum": [
        "DRAFT",
        "PROPOSED",
        "PREVIEW",
        "SAVED",
        "VERIFIED",
        "APPROVED",
        "APPLIED",
        "DISCARDED"
      ],
      "title": "Stage",
      "type": "string"
    },
    "request": {
      "title": "Request",
      "type": "string"
    },
    "baseline_version": {
      "title": "Baseline Version",
      "type": "integer"
    },
    "baseline": {
      "$ref": "#/$defs/Workflow"
    },
    "candidate": {
      "anyOf": [
        {
          "$ref": "#/$defs/Workflow"
        },
        {
          "type": "null"
        }
      ]
    },
    "proposal": {
      "anyOf": [
        {
          "$ref": "#/$defs/Proposal"
        },
        {
          "type": "null"
        }
      ]
    },
    "provider_run": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Provider Run"
    },
    "selected_meaning": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected Meaning"
    },
    "selected_by": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "title": "Selected By"
    },
    "transactions": {
      "items": {
        "discriminator": {
          "mapping": {
            "add_state": "#/$defs/AddState",
            "add_transition": "#/$defs/AddTransition",
            "remove_state": "#/$defs/RemoveState",
            "remove_transition": "#/$defs/RemoveTransition",
            "rename_state": "#/$defs/RenameState",
            "retarget_transition": "#/$defs/RetargetTransition",
            "set_effects": "#/$defs/SetEffects",
            "set_guards": "#/$defs/SetGuards",
            "set_initial": "#/$defs/SetInitial",
            "set_role": "#/$defs/SetRole"
          },
          "propertyName": "kind"
        },
        "oneOf": [
          {
            "$ref": "#/$defs/AddState"
          },
          {
            "$ref": "#/$defs/RenameState"
          },
          {
            "$ref": "#/$defs/RemoveState"
          },
          {
            "$ref": "#/$defs/SetInitial"
          },
          {
            "$ref": "#/$defs/AddTransition"
          },
          {
            "$ref": "#/$defs/RetargetTransition"
          },
          {
            "$ref": "#/$defs/RemoveTransition"
          },
          {
            "$ref": "#/$defs/SetRole"
          },
          {
            "$ref": "#/$defs/SetGuards"
          },
          {
            "$ref": "#/$defs/SetEffects"
          }
        ]
      },
      "title": "Transactions",
      "type": "array"
    },
    "layout": {
      "additionalProperties": {
        "additionalProperties": {
          "type": "integer"
        },
        "type": "object"
      },
      "title": "Layout",
      "type": "object"
    },
    "receipts": {
      "items": {
        "additionalProperties": true,
        "type": "object"
      },
      "title": "Receipts",
      "type": "array"
    },
    "decision": {
      "anyOf": [
        {
          "additionalProperties": true,
          "type": "object"
        },
        {
          "type": "null"
        }
      ],
      "title": "Decision"
    },
    "created_at": {
      "title": "Created At",
      "type": "string"
    }
  },
  "required": [
    "id",
    "version",
    "stage",
    "request",
    "baseline_version",
    "baseline",
    "candidate",
    "proposal",
    "provider_run",
    "selected_meaning",
    "selected_by",
    "transactions",
    "layout",
    "receipts",
    "decision",
    "created_at"
  ],
  "title": "ChangeCase",
  "type": "object"
}
