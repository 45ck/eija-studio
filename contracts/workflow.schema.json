{
  "$defs": {
    "Composite": {
      "additionalProperties": false,
      "description": "A UML composite state (issue #93 item 3, ADR-0240): a named group of states, or of other composites, with the\nchild a transition into the group enters first. A record is always in exactly one plain state; the composite is the\nset of states inside it. The kernel runs the flat machine, so a composite never changes what a step does. A\ntransition the group's states all share is drawn once from the group, and SCXML gets a nested `<state>`.",
      "properties": {
        "name": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Name",
          "type": "string"
        },
        "states": {
          "items": {
            "type": "string"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "States",
          "type": "array"
        },
        "initial": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Initial",
          "type": "string"
        }
      },
      "required": [
        "name",
        "states",
        "initial"
      ],
      "title": "Composite",
      "type": "object"
    },
    "Delay": {
      "additionalProperties": false,
      "description": "A UML time event, ``after(14 days)`` (issue #93, ADR-0237): the transition may be taken only once the record has\nbeen in its source state this long. Time is measured from when the record entered that state, which every\ncommitted step does, a step back into the same state included. An unknown entry time never counts as due.",
      "properties": {
        "amount": {
          "maximum": 10000,
          "minimum": 1,
          "title": "Amount",
          "type": "integer"
        },
        "unit": {
          "enum": [
            "minutes",
            "hours",
            "days"
          ],
          "title": "Unit",
          "type": "string"
        }
      },
      "required": [
        "amount",
        "unit"
      ],
      "title": "Delay",
      "type": "object"
    },
    "LinkedObject": {
      "additionalProperties": false,
      "description": "The lifecycle of the object a record links to through a reference field, such as a deploy request's `target`\nservice (issue #93 item 4, ADR-0241): a small state machine of its own, moved only by the record's steps\n(`Transition.then`). An object in a state with no move for the event refuses the record's step; so does an unknown\nobject or state.",
      "properties": {
        "link": {
          "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$",
          "title": "Link",
          "type": "string"
        },
        "entity": {
          "pattern": "^[A-Z][A-Za-z0-9]{0,39}$",
          "title": "Entity",
          "type": "string"
        },
        "states": {
          "items": {
            "type": "string"
          },
          "maxItems": 8,
          "minItems": 1,
          "title": "States",
          "type": "array"
        },
        "initial": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Initial",
          "type": "string"
        },
        "moves": {
          "items": {
            "$ref": "#/$defs/Move"
          },
          "maxItems": 32,
          "minItems": 1,
          "title": "Moves",
          "type": "array"
        }
      },
      "required": [
        "link",
        "entity",
        "states",
        "initial",
        "moves"
      ],
      "title": "LinkedObject",
      "type": "object"
    },
    "LinkedStep": {
      "additionalProperties": false,
      "description": "What a transition does to an object the record links to, written ``target.lock`` (issue #93 item 4, ADR-0241): the\nobject named by the record's `link` field takes `event` in its own lifecycle, in the same step.",
      "properties": {
        "link": {
          "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$",
          "title": "Link",
          "type": "string"
        },
        "event": {
          "pattern": "^[a-z][a-zA-Z0-9]{0,39}$",
          "title": "Event",
          "type": "string"
        }
      },
      "required": [
        "link",
        "event"
      ],
      "title": "LinkedStep",
      "type": "object"
    },
    "Move": {
      "additionalProperties": false,
      "description": "One transition in a linked object's lifecycle: `event` moves it from `from_state` to `to_state` (ADR-0241).",
      "properties": {
        "event": {
          "pattern": "^[a-z][a-zA-Z0-9]{0,39}$",
          "title": "Event",
          "type": "string"
        },
        "from_state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "From State",
          "type": "string"
        },
        "to_state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "To State",
          "type": "string"
        }
      },
      "required": [
        "event",
        "from_state",
        "to_state"
      ],
      "title": "Move",
      "type": "object"
    },
    "Receive": {
      "additionalProperties": false,
      "description": "A signal another workflow of the system sends that starts a record here (issue #93 item 5, ADR-0242): the\nsignal effect `signal` declared by the pack `sender`.",
      "properties": {
        "signal": {
          "pattern": "^Signal:[A-Z][A-Za-z0-9]{0,59}$",
          "title": "Signal",
          "type": "string"
        },
        "sender": {
          "pattern": "^[a-z][a-z0-9-]{0,39}$",
          "title": "Sender",
          "type": "string"
        }
      },
      "required": [
        "signal",
        "sender"
      ],
      "title": "Receive",
      "type": "object"
    },
    "Transition": {
      "additionalProperties": false,
      "properties": {
        "id": {
          "pattern": "^[A-Z][A-Z0-9_-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "action": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "from_state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "From State",
          "type": "string"
        },
        "to_state": {
          "maxLength": 60,
          "minLength": 1,
          "title": "To State",
          "type": "string"
        },
        "role": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Role",
          "type": "string"
        },
        "guards": {
          "items": {
            "enum": [
              "actor_active",
              "role_current",
              "actor_assigned",
              "state_equals",
              "expected_version",
              "operation_binding"
            ],
            "type": "string"
          },
          "title": "Guards",
          "type": "array"
        },
        "required_effects": {
          "items": {
            "type": "string"
          },
          "title": "Required Effects",
          "type": "array"
        },
        "forbidden_effects": {
          "items": {
            "type": "string"
          },
          "title": "Forbidden Effects",
          "type": "array"
        },
        "conditions": {
          "default": [],
          "items": {
            "$ref": "#/$defs/ValueGuard"
          },
          "maxItems": 8,
          "title": "Conditions",
          "type": "array"
        },
        "after": {
          "anyOf": [
            {
              "$ref": "#/$defs/Delay"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "then": {
          "default": [],
          "items": {
            "$ref": "#/$defs/LinkedStep"
          },
          "maxItems": 2,
          "title": "Then",
          "type": "array"
        }
      },
      "required": [
        "id",
        "action",
        "from_state",
        "to_state",
        "role",
        "guards",
        "required_effects",
        "forbidden_effects"
      ],
      "title": "Transition",
      "type": "object"
    },
    "ValueGuard": {
      "additionalProperties": false,
      "description": "A UML guard over one of the record's values, such as ``[amount > 500]`` (issue #93, ADR-0234). The transition\nfires only when it holds. A value that is missing, or of another kind, never satisfies it (fail closed).",
      "properties": {
        "attribute": {
          "pattern": "^[a-z][a-zA-Z0-9_]{0,39}$",
          "title": "Attribute",
          "type": "string"
        },
        "op": {
          "enum": [
            "eq",
            "ne",
            "lt",
            "le",
            "gt",
            "ge"
          ],
          "title": "Op",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "type": "boolean"
            },
            {
              "type": "integer"
            },
            {
              "type": "number"
            },
            {
              "type": "string"
            }
          ],
          "title": "Value"
        }
      },
      "required": [
        "attribute",
        "op",
        "value"
      ],
      "title": "ValueGuard",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "eija.workflow.v1",
      "default": "eija.workflow.v1",
      "title": "Schema Version",
      "type": "string"
    },
    "id": {
      "pattern": "^[a-z][a-z0-9-]{0,39}$",
      "title": "Id",
      "type": "string"
    },
    "initial_state": {
      "title": "Initial State",
      "type": "string"
    },
    "states": {
      "items": {
        "type": "string"
      },
      "maxItems": 32,
      "minItems": 1,
      "title": "States",
      "type": "array"
    },
    "transitions": {
      "items": {
        "$ref": "#/$defs/Transition"
      },
      "maxItems": 64,
      "minItems": 1,
      "title": "Transitions",
      "type": "array"
    },
    "initiators": {
      "default": [],
      "items": {
        "type": "string"
      },
      "maxItems": 16,
      "title": "Initiators",
      "type": "array"
    },
    "composites": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Composite"
      },
      "maxItems": 16,
      "title": "Composites",
      "type": "array"
    },
    "objects": {
      "default": [],
      "items": {
        "$ref": "#/$defs/LinkedObject"
      },
      "maxItems": 8,
      "title": "Objects",
      "type": "array"
    },
    "receives": {
      "default": [],
      "items": {
        "$ref": "#/$defs/Receive"
      },
      "maxItems": 16,
      "title": "Receives",
      "type": "array"
    }
  },
  "required": [
    "id",
    "initial_state",
    "states",
    "transitions"
  ],
  "title": "Workflow",
  "type": "object"
}
