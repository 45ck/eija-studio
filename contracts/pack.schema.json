    "Meaning": {
      "additionalProperties": false,
      "description": "One interpretation of a request. A supported meaning's transactions produce the candidate; an unsupported\none's transactions (if any) describe what it WOULD do, for explanation only, never as a candidate.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9_]{0,39}$",
          "title": "Id",
          "type": "string"
        },
        "label": {
          "maxLength": 200,
          "minLength": 1,
