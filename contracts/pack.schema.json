    "ActionRequiresGuard": {
      "additionalProperties": false,
      "description": "Every transition performing ``action`` carries at least ``guards``.",
      "properties": {
        "id": {
          "pattern": "^[a-z][a-z0-9-]{0,63}$",
          "title": "Id",
          "type": "string"
        },
        "code": {
          "pattern": "^[A-Z][A-Z0-9_]{0,63}(:[A-Za-z0-9_-]{1,64})?$",
          "title": "Code",
          "type": "string"
        },
        "description": {
          "default": "",
          "maxLength": 400,
          "title": "Description",
          "type": "string"
        },
        "when": {
          "anyOf": [
            {
              "$ref": "#/$defs/When"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "kind": {
          "const": "action_requires_guard",
          "title": "Kind",
          "type": "string"
        },
        "action": {
          "maxLength": 60,
          "minLength": 1,
          "title": "Action",
          "type": "string"
        },
        "guards": {
          "items": {
            "enum": [
              "actor_active",
              "role_current",
              "actor_assigned",
              "state_equals",
              "expected_version",
              "operation_binding"
            ],
            "type": "string"
          },
          "minItems": 1,
          "title": "Guards",
          "type": "array"
        }
      },
      "required": [
        "id",
        "code",
        "kind",
        "action",
        "guards"
      ],
      "title": "ActionRequiresGuard",
      "type": "object"
    },
