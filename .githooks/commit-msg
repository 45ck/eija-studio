#!/bin/sh
# noslop commit-msg: enforce Conventional Commits and block CI-bypass tricks.
# Merge, revert and fixup commits generated by git itself are allowed.
MSG_FILE="$1"
MSG=$(cat "$MSG_FILE")
FIRST=$(head -n 1 "$MSG_FILE")

if echo "$MSG" | grep -qiE '\[skip ci\]|skip-checks|--no-verify'; then
  echo "noslop: commit message contains a CI-bypass pattern." >&2
  exit 1
fi

case "$FIRST" in
  "Merge "*|"Revert \""*|"fixup! "*|"squash! "*) exit 0 ;;
esac

PATTERN='^(feat|fix|docs|style|refactor|perf|test|chore|ci|build|revert)(\(.+\))?(!)?: .{1,100}$'
if ! echo "$FIRST" | grep -qE "$PATTERN"; then
  echo "noslop: commit subject does not follow Conventional Commits." >&2
  echo "  Expected: type(scope): description   (got: $FIRST)" >&2
  exit 1
fi
