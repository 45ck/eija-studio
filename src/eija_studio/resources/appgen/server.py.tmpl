def serve(database: str, port: int) -> None:
    service = Service(database)
    server = ThreadingHTTPServer(("127.0.0.1", port), handler_for(service))
    print(f"{PACK.pack.name}: http://127.0.0.1:{port}/  (model {MODEL.semantic_hash[:12]}; Ctrl+C to stop)", flush=True)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        pass
    finally:
        server.server_close()
