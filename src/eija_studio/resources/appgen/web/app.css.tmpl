/* Generated apps reuse the existing palette. Spacing/type roles follow design/tokens:
   space.1/2/3/4/6, font.size.sm/md/lg/xl, radius.1/2 and focus.offset. */
:root{--bg:#f6f7f9;--panel:#fff;--ink:#1d2330;--muted:#5d6678;--line:#dde1e8;--accent:#2f5bd3;--accent-ink:#fff;
  --ok:#1f7a4d;--ok-bg:#e6f4ec;--bad:#a23434;--bad-bg:#fbeaea;--warn-bg:#fff4dc;--current:#e8eefc;
  --space-1:.25rem;--space-2:.5rem;--space-3:.75rem;--space-4:1rem;--space-6:1.5rem;
  --text-ui:.875rem;--text-body:1rem;--text-heading:1.25rem;--text-title:1.5rem;--radius-control:4px;--radius-panel:8px;
  --app-bar-height:0px;
  font-family:system-ui,-apple-system,"Segoe UI",Roboto,sans-serif;line-height:1.5;color:var(--ink);background:var(--bg);
  color-scheme:light;font-variant-numeric:tabular-nums}
@media (prefers-color-scheme:dark){:root{--bg:#14171d;--panel:#1c2029;--ink:#e6e9ef;--muted:#9aa3b5;--line:#2d3340;
  --accent:#7c9cf5;--accent-ink:#0f1320;--ok:#6fd3a0;--ok-bg:#183327;--bad:#f09a9a;--bad-bg:#3a1f22;--warn-bg:#3a3020;
  --current:#25304a;color-scheme:dark}}
*{box-sizing:border-box}
[hidden]{display:none!important}
body{margin:0;background:var(--bg)}
::selection{background:var(--accent);color:var(--accent-ink)}
.bar{display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-4);padding:var(--space-6);
  background:var(--panel);border-bottom:1px solid var(--line);flex-wrap:wrap}
.bar>div{min-width:0}
@media (min-height:480px){html{scroll-padding-block-start:var(--app-bar-height)}
  .bar{position:sticky;inset-block-start:0;z-index:10}
  .layout :is(button,input,select,summary,[tabindex="-1"]){scroll-margin-block:var(--space-4)}}
h1{font-size:var(--text-title);line-height:1.333333;margin:0;font-weight:600;overflow-wrap:anywhere}
h2{font-size:var(--text-heading);line-height:1.4;margin:0 0 var(--space-4);font-weight:600;overflow-wrap:anywhere}
h3{font-size:var(--text-ui);font-weight:600;margin:var(--space-6) 0 var(--space-2)}
.sub,.muted{color:var(--muted);margin:var(--space-1) 0 0;font-size:var(--text-ui);overflow-wrap:anywhere}
.small{font-size:var(--text-ui)}
code{font-size:var(--text-ui)}
.actor{display:flex;align-items:center;gap:var(--space-2);font-size:var(--text-ui);min-width:0;max-width:100%;flex-wrap:wrap}
select,input,button{font:inherit;font-size:var(--text-body);padding:var(--space-2) var(--space-3);min-height:40px;
  border-radius:var(--radius-control);border:1px solid var(--line);background:var(--panel);color:var(--ink);max-width:100%;min-width:0}
input,select{caret-color:var(--accent)}
input::placeholder{color:var(--muted);opacity:1}
input[type=checkbox]{min-height:24px;width:24px;padding:0;accent-color:var(--accent)}
button{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);cursor:pointer;
  overflow-wrap:anywhere;white-space:normal;text-align:left}
button:hover:not(:disabled){text-decoration:underline;text-underline-offset:3px}
button:active:not(:disabled){outline:1px solid var(--ink);outline-offset:-3px}
button.quiet{background:var(--panel);color:var(--ink);border-color:var(--line)}
button:disabled{background:transparent;color:var(--muted);border-color:var(--line);cursor:not-allowed}
:focus-visible,.notice:focus{outline:2px solid var(--accent);outline-offset:2px}
[aria-invalid=true]{border-color:var(--bad)}
.layout{display:grid;grid-template-columns:minmax(224px,1fr) minmax(0,2fr) minmax(0,1.35fr);
  align-items:start;gap:var(--space-4);padding:var(--space-6)}
.panel{background:var(--panel);border:1px solid var(--line);border-radius:var(--radius-panel);padding:var(--space-4);min-width:0}
.create{display:flex;flex-direction:column;gap:var(--space-2);margin-bottom:var(--space-6)}
.create h3{margin:0}
.create button{align-self:flex-start}
.create>label{font-size:var(--text-ui)}
.records{list-style:none;margin:0;padding:0;display:flex;flex-direction:column;gap:var(--space-1)}
.records button{width:100%;display:flex;justify-content:space-between;align-items:flex-start;gap:var(--space-2);
  background:transparent;color:var(--ink);border:1px solid transparent;text-align:left}
.records button>span{min-width:0;overflow-wrap:anywhere}
.records button[aria-current="true"]{background:var(--current);border-color:var(--line);font-weight:600}
.chip{font-size:var(--text-ui);padding:var(--space-1) var(--space-2);border-radius:var(--radius-control);
  background:var(--current);color:var(--ink);overflow-wrap:anywhere}
.records .chip{flex:0 1 45%}
.record-state{margin:0 0 var(--space-4);font-size:var(--text-ui)}
.record-state strong{display:inline-block;margin-inline-start:var(--space-2)}
.flow{list-style:none;display:flex;flex-wrap:wrap;gap:var(--space-2);margin:0;padding:0}
.flow li{font-size:var(--text-ui);padding:var(--space-1) var(--space-2);border-radius:var(--radius-control);
  border:1px solid var(--line);color:var(--muted);max-width:100%;overflow-wrap:anywhere}
.flow li[aria-current="step"]{background:var(--accent);color:var(--accent-ink);border-color:var(--accent);font-weight:600}
.options{display:flex;flex-direction:column;gap:var(--space-3)}
.option{display:flex;align-items:center;gap:var(--space-2);flex-wrap:wrap;min-width:0}
.option .why{font-size:var(--text-ui);color:var(--muted);overflow-wrap:anywhere;flex-basis:100%}
.notice{padding:var(--space-3);border-radius:var(--radius-control);margin:var(--space-3) 0 0;
  font-size:var(--text-body);overflow-wrap:anywhere}
.notice.ok{background:var(--ok-bg);color:var(--ok)}
.notice.bad{background:var(--bad-bg);color:var(--bad)}
.notice.warn{background:var(--warn-bg)}
.load-feedback{margin:var(--space-4) var(--space-6) 0}
.load-feedback p{margin:0 0 var(--space-2)}
.history,.outbox{margin:0;padding-inline-start:var(--space-6);font-size:var(--text-ui);overflow-wrap:anywhere}
.history li,.outbox li{margin:var(--space-2) 0}
.rules{width:100%;table-layout:fixed;border-collapse:collapse;font-size:var(--text-ui)}
.rules th,.rules td{text-align:left;vertical-align:top;padding:var(--space-2) var(--space-1);
  border-bottom:1px solid var(--line);overflow-wrap:anywhere}
.rules th{font-weight:600}
.rules caption{text-align:left;color:var(--muted);padding:0 0 var(--space-2)}
.rule-label{display:none}
.rule-value{min-width:0;overflow-wrap:anywhere}
/* A narrow side panel needs full-width rule values even on a wide desktop.
   Keep the native table and its header associations; only the visual layout changes. */
.layout>aside{container-type:inline-size;container-name:app-rules}
@container app-rules (max-width:32rem){
  .rules{display:block}
  .rules caption{display:block}
  .rules thead{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
  .rules tbody{display:block}
  .rules tbody tr{display:block;padding-block:var(--space-2);border-bottom:1px solid var(--line)}
  .rules td{display:grid;grid-template-columns:3.5rem minmax(0,1fr);gap:var(--space-2);
    padding:var(--space-1);border-bottom:0}
  .rule-label{display:block;color:var(--muted);font-weight:400}
}
.visually-hidden{position:absolute;width:1px;height:1px;overflow:hidden;clip:rect(0 0 0 0)}
.fields{display:grid;grid-template-columns:minmax(0,1fr);gap:var(--space-2);font-size:var(--text-ui)}
.fields label{margin-top:var(--space-2);overflow-wrap:anywhere}
.fields input,.fields select{width:100%}
.fields input[type=checkbox]{justify-self:start;width:24px}
.values{display:grid;grid-template-columns:minmax(0,1fr) minmax(0,2fr);gap:var(--space-2) var(--space-3);
  font-size:var(--text-ui);margin:0 0 var(--space-4)}
.values dt{color:var(--muted);overflow-wrap:anywhere}
.values dd{margin:0;overflow-wrap:anywhere}
.action-screen{margin-top:var(--space-4);padding-top:var(--space-4);border-top:1px solid var(--line)}
.action-screen h3{margin-top:0}
.actor-box{display:flex;flex-direction:column;align-items:flex-end;gap:var(--space-2);max-width:min(100%,34rem)}
.role{font-size:var(--text-ui);color:var(--ink);overflow-wrap:anywhere;text-align:right;max-width:100%}
.role:empty{display:none}
.role.warn{background:var(--warn-bg);padding:var(--space-1) var(--space-2)}
.others{margin-top:var(--space-2);font-size:var(--text-ui)}
.others summary{cursor:pointer;color:var(--muted);padding:var(--space-2) 0;min-height:40px}
.others .option{margin:var(--space-3) 0 0 var(--space-4)}
.rules tr.mine td{background:var(--current);font-weight:600}
.detail[aria-busy=true] #options::before{content:"Saving…";color:var(--muted)}
@media (max-width:1200px){.layout{grid-template-columns:minmax(224px,1fr) minmax(0,2fr)}.layout>aside{grid-column:1/-1}}
@media (max-width:800px){.layout{grid-template-columns:minmax(0,1fr);padding:var(--space-4)}
  .bar{padding:var(--space-4)}.actor-box{align-items:flex-start}.role{text-align:left}
  .load-feedback{margin-inline:var(--space-4)}}
@media (max-width:400px){.values{grid-template-columns:minmax(0,1fr)}.values dd{margin-bottom:var(--space-2)}
  .actor{display:grid;grid-template-columns:minmax(0,1fr);width:100%}.actor-box{width:100%}}
