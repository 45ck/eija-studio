<!doctype html>
<html lang="en">
<head>
  <meta charset="utf-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Generated app</title>
  <link rel="stylesheet" href="/app.css">
  <script src="/app.js" defer></script>
</head>
<body>
  <header class="bar">
    <div>
      <h1 id="app-name">Loading</h1>
      <details class="app-about"><summary>About this app</summary><p id="app-description" class="sub">Preparing your local app…</p></details>
    </div>
    <div class="actor-box">
      <label class="actor">Act as <span class="fixture-label">local fixture</span>
        <select id="actor" disabled></select>
      </label>
      <span id="actor-role" class="role" aria-live="polite"></span>
    </div>
  </header>
  <section id="load-feedback" class="notice bad load-feedback" role="alert" hidden>
    <p id="load-error"></p>
    <button id="retry-load" class="quiet" type="button">Reload app data</button>
  </section>
  <main class="layout">
    <section class="panel" aria-labelledby="records-title">
      <h2 id="records-title">Records</h2>
      <form id="create" class="create" aria-labelledby="create-title">
        <h3 id="create-title">New record</h3>
        <label for="title">Title</label>
        <input id="title" maxlength="200" placeholder="New record title" required>
        <div id="fields" class="fields"></div>
        <button type="submit" id="create-button" disabled>Create</button>
        <p id="create-feedback" class="notice bad" role="alert" tabindex="-1" hidden></p>
      </form>
      <ul id="records" class="records"></ul>
      <p id="empty" class="muted">No records yet. Create one to start.</p>
    </section>
    <section class="panel detail" aria-labelledby="detail-title">
      <h2 id="detail-title" tabindex="-1">Select a record</h2>
      <p id="record-state" class="record-state" hidden>Current state <strong id="current-state" class="chip"></strong></p>
      <dl id="detail-fields" class="values"></dl>
      <ol id="flow" class="flow" aria-label="States"></ol>
      <div id="stranded" class="notice warn" hidden>This record was created under an earlier model or data model. Actions on it are refused (STALE_INSTANCE or STALE_DATA).</div>
      <h3>Choose an action</h3>
      <div id="options" class="options"></div>
      <section id="action-screen" class="action-screen" aria-live="polite" hidden></section>
      <p id="result" class="notice" role="status" aria-live="polite" tabindex="-1" hidden></p>
      <h3>History</h3>
      <ol id="history" class="history"></ol>
    </section>
    <aside class="panel runtime-panel" aria-label="Model and runtime details">
      <details id="runtime-details">
        <summary><strong>Model &amp; runtime details</strong><span>Inspect rules, recorded effects and build identity</span></summary>
        <div class="runtime-body">
      <h2 id="rules-title">Rules from the model</h2>
      <table class="rules" role="table">
        <caption>Allowed state changes and their required role</caption>
        <thead role="rowgroup"><tr role="row"><th id="rule-action" scope="col" role="columnheader">Action</th><th id="rule-from" scope="col" role="columnheader">From</th><th id="rule-to" scope="col" role="columnheader">To</th><th id="rule-role" scope="col" role="columnheader">Who</th></tr></thead>
        <tbody id="rules" role="rowgroup"></tbody>
      </table>
      <h3>Outbox</h3>
      <ul id="outbox" class="outbox"></ul>
      <p class="muted small">Notifications are recorded here, not sent.</p>
      <p class="muted small">Built by EIJA Studio from model <code id="model-hash"></code></p>
        </div>
      </details>
      <p class="runtime-scope">Local fixture actors · real local records. No login or external delivery.</p>
    </aside>
  </main>
</body>
</html>
