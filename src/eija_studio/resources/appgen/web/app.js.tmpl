// Generated by EIJA Studio. Every decision is made by the server; this page only shows what it says.
"use strict";
const $ = (id) => document.getElementById(id);
const state = { app: null, actor: "", selected: "", writing: false, fresh: false, read: 0 };

// Optional inspection channel for an embedded app. Messages grant no authority and contain no record values.
// Chromium exposes the immediate ancestor origin even under PlayIDE's normal no-referrer policy.
const runtimeParentOrigin = (() => {
  if (window.parent === window) return "";
  try {
    const parent = new URL(location.ancestorOrigins && location.ancestorOrigins[0] || document.referrer);
    return ["http:", "https:"].includes(parent.protocol) ? parent.origin : "";
  } catch { return ""; }
})();
const runtimeUuid = /^[0-9a-f]{8}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{4}-[0-9a-f]{12}$/i;
let runtimeConnection = null;

function runtimeSubject() {
  const subject = state.app && state.app.subject;
  return subject && subject.format === "eija.build-subject.v1" && subject.model_hash === state.app.model_hash && typeof subject.digest === "string"
    && /^[0-9a-f]{64}$/.test(subject.digest) ? subject.digest : null;
}

function runtimeReady() {
  if (runtimeParentOrigin && state.app && runtimeSubject()) window.parent.postMessage({
    type: "playide.runtime.ready.v1", modelHash: state.app.model_hash, subjectHash: runtimeSubject()
  }, runtimeParentOrigin);
}

window.addEventListener("message", (event) => {
  const message = event.data;
  if (!runtimeParentOrigin || event.source !== window.parent || event.origin !== runtimeParentOrigin || !state.app
    || !message || Array.isArray(message) || Object.keys(message).length !== 4
    || message.type !== "playide.runtime.connect.v1" || message.modelHash !== state.app.model_hash
    || !runtimeSubject() || message.subjectHash !== runtimeSubject()
    || typeof message.nonce !== "string" || !runtimeUuid.test(message.nonce)) return;
  if (runtimeConnection && runtimeConnection.nonce === message.nonce && runtimeConnection.modelHash === message.modelHash
    && runtimeConnection.subjectHash === message.subjectHash) return;
  runtimeConnection = { origin: event.origin, nonce: message.nonce, modelHash: message.modelHash, subjectHash: message.subjectHash };
});

function runtimeText(value, limit) {
  return typeof value === "string" && value.length > 0 && value.length <= limit;
}

function runtimeAttempt(action, record, operationId) {
  if (!runtimeConnection || !state.app || runtimeConnection.modelHash !== state.app.model_hash
    || runtimeConnection.subjectHash !== runtimeSubject()
    || record.current_model !== true || record.model_hash !== state.app.model_hash
    || !/^[0-9a-f]{64}$/.test(record.model_hash) || !/^[0-9a-f]{32}$/.test(record.id)
    || !Number.isSafeInteger(record.version) || record.version < 0 || !runtimeText(record.state, 60)
    || !runtimeText(action, 60) || !runtimeText(state.actor, 80) || !runtimeUuid.test(operationId)) return null;
  return { connection: runtimeConnection, read: state.read, modelHash: record.model_hash, subjectHash: runtimeConnection.subjectHash, recordId: record.id,
    version: record.version, action, from: record.state, actorId: state.actor, operationId };
}

function runtimeOutcome(attempt, result, error) {
  // Do not repaint a newer model/view or a newly connected parent with an older request's outcome.
  if (!attempt || attempt.connection !== runtimeConnection || attempt.read !== state.read || !state.app
    || attempt.modelHash !== state.app.model_hash || attempt.subjectHash !== runtimeSubject()
    || attempt.actorId !== state.actor || attempt.recordId !== state.selected) return;
  let outcome;
  if (error) {
    if (!Number.isInteger(error.status) || error.status < 400 || error.status >= 500
      || typeof error.code !== "string" || !/^[A-Z][A-Z0-9_]{0,79}$/.test(error.code)) return;
    // A refusal has no record receipt. from/version are the attempted baseline, not observed current state.
    outcome = { kind: "refused", version: attempt.version, to: attempt.from, effects: [], code: error.code };
  } else {
    const record = result && result.record;
    if (!result || result.committed !== true || result.duplicate !== false || !record
      || record.current_model !== true || record.model_hash !== attempt.modelHash || record.id !== attempt.recordId
      || record.version !== attempt.version + 1 || !Number.isSafeInteger(record.version) || !runtimeText(record.state, 60)
      || !Array.isArray(result.effects) || result.effects.length > 64 || !result.effects.every(effect => runtimeText(effect, 80))) return;
    outcome = { kind: "committed", version: record.version, to: record.state, effects: [...result.effects] };
  }
  const { modelHash, subjectHash, recordId, action, from, actorId, operationId } = attempt;
  window.parent.postMessage({ type: "playide.runtime.v1", nonce: attempt.connection.nonce,
    modelHash, subjectHash, recordId, action, from, actorId, operationId, ...outcome }, attempt.connection.origin);
}

// Layout only: wrapped actor notes and viewport changes determine the real sticky-header height.
// Short embedded previews keep the header in normal flow through the CSS height query.
function trackBarHeight() {
  const bar = document.querySelector(".bar");
  const measure = () => document.documentElement.style.setProperty("--app-bar-height", `${Math.ceil(bar.getBoundingClientRect().height)}px`);
  if (typeof ResizeObserver !== "undefined") new ResizeObserver(measure).observe(bar);
  window.addEventListener("resize", measure);
  measure();
}

function el(tag, text, attrs = {}) {
  const node = document.createElement(tag);
  if (text !== undefined) node.textContent = text;
  for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
  return node;
}

async function api(path, body) {
  const options = body === undefined ? {} : { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) };
  const response = await fetch(path, options);
  const value = await response.json();
  if (!response.ok) throw Object.assign(new Error(value.message || "Refused"), { code: value.code, status: response.status });
  return value;
}

function refusal(error) {
  const recovery = {
    STALE_VERSION: "Review the refreshed state, then choose an action again.",
    ROLE_DENIED: "Choose an actor with the required role.",
    ASSIGNMENT_DENIED: "Choose an actor assigned to this record.",
    ACTOR_REVOKED: "Choose an active fixture actor.",
    STALE_INSTANCE: "This record belongs to an earlier model. It needs a supported migration before actions can run.",
    STALE_DATA: "This record belongs to an earlier data model. It needs a supported migration before actions can run."
  };
  return error.code ? [`Refused (${error.code}): ${error.message}`, recovery[error.code]].filter(Boolean).join(" ")
    : `Request failed: ${error.message}. Reload app data to check the latest state.`;
}

function say(text, kind, target = "result") {
  const box = $(target);
  box.hidden = false;
  box.className = "notice " + kind;
  box.textContent = text;
}

function showLoadError(error) {
  $("load-error").textContent = `App data could not be loaded. ${refusal(error)} Last observed details and form entries are kept. Actions are paused until app data reloads.`;
  $("load-feedback").hidden = false;
}

function setWriting(busy) {
  state.writing = busy;
  $("create-button").disabled = busy || !state.fresh;
  $("actor").disabled = busy || !state.app;
  $("create").setAttribute("aria-busy", String(busy));
  document.querySelector(".detail").setAttribute("aria-busy", String(busy));
  for (const button of document.querySelectorAll("#options button, #action-screen button")) {
    button.disabled = busy || !state.fresh || button.dataset.allowed === "false";
  }
  for (const button of document.querySelectorAll("#records button")) button.disabled = busy;
}

async function refreshSafely() {
  const read = state.read + 1;
  try {
    if (!await refresh()) return false;
    $("load-feedback").hidden = true;
    return true;
  } catch (error) {
    if (read === state.read) showLoadError(error);
    return false;
  }
}

function renderRules() {
  const body = $("rules");
  body.replaceChildren();
  const columns = [["Action", "rule-action"], ["From", "rule-from"], ["To", "rule-to"], ["Who", "rule-role"]];
  for (const [action, t] of Object.entries(state.app.transitions)) {
    const row = el("tr", undefined, { "data-role": t.role, role: "row" });
    [action, t.from, t.to, t.role].forEach((text, index) => {
      const [label, header] = columns[index];
      const cell = el("td", undefined, { headers: header, role: "cell" });
      // Compact visual labels repeat the actual column headings, not policy. Assistive
      // technology uses the native header association and reads each value only once.
      cell.append(el("span", label, { class: "rule-label", "aria-hidden": "true" }), el("span", text, { class: "rule-value" }));
      row.append(cell);
    });
    body.append(row);
  }
}

// The record's attributes come from the data model (class diagram); the server checks every value.
// Which ones the form asks for, in what order and under what label, comes from the create screen (ADR-0154).
function attribute(name) {
  return state.app.record.attributes.find((a) => a.name === name);
}

function screenFields(screen) {
  if (!state.app.record || !screen) return [];
  return screen.fields.map((f) => ({ ...attribute(f.attribute), label: f.label || f.attribute }));
}

// Each action has its own screen: its title, the record values it shows (in its order, under its labels) and its
// button. Choosing an action opens it; the action runs only when its button is pressed, and the kernel decides.
function openAction(option, record, opener) {
  if (state.writing || !state.fresh) return;
  const screen = state.app.screens.actions[option.action] || { title: option.action, fields: [], button: option.action };
  const box = $("action-screen");
  box.hidden = false;
  box.replaceChildren(el("h3", screen.title),
    el("p", `${record.state} → ${option.to}`, { class: "action-consequence" }));
  const values = el("dl", undefined, { class: "values" });
  for (const a of screenFields(screen)) values.append(el("dt", a.label), el("dd", a.name in record.fields ? String(record.fields[a.name]) : "—"));
  const go = el("button", screen.button || option.action, { type: "button" });
  go.addEventListener("click", () => { box.hidden = true; act(option.action, record); });
  // Close, never Cancel: a workflow may have an action of that name, and this button only closes the screen.
  const close = el("button", "Close", { type: "button", class: "quiet" });
  close.addEventListener("click", () => {
    box.hidden = true;
    (opener && opener.isConnected ? opener : $("detail-title")).focus();
  });
  const row = el("div", undefined, { class: "option" });
  row.append(go, close);
  box.append(values, row);
  go.focus();
}

function renderFields() {
  const box = $("fields");
  box.replaceChildren();
  const create = state.app.screens.create;
  if (create) {
    $("create-title").textContent = create.title;
    $("create-button").textContent = create.button || "Create";
  }
  for (const a of screenFields(create)) {
    const id = "field-" + a.name, label = el("label", a.label + (a.required ? " *" : ""), { for: id });
    let input;
    if (a.type === "choice") {
      input = el("select", undefined, { id });
      input.append(el("option", "", { value: "" }), ...a.choices.map((c) => el("option", c, { value: c })));
    } else if (a.type === "boolean") {
      input = el("input", undefined, { id, type: "checkbox" });
    } else {
      input = el("input", undefined, { id, type: { number: "number", date: "date" }[a.type] || "text" });
      if (a.type === "text") input.maxLength = a.max_length;
      if (a.type === "number") input.step = "any";
    }
    if (a.required && a.type !== "boolean") input.required = true;
    box.append(label, input);
  }
}

function fieldValues() {
  const values = {};
  for (const a of screenFields(state.app.screens.create)) {
    const input = $("field-" + a.name);
    if (a.type === "boolean") values[a.name] = input.checked;
    else if (input.value === "") continue;
    else values[a.name] = a.type === "number" ? Number(input.value) : input.value;
  }
  return values;
}

async function renderRecords(read) {
  const records = await api("/api/records");
  if (read !== state.read) return false;
  const list = $("records");
  list.replaceChildren();
  $("empty").hidden = records.length > 0;
  for (const r of records) {
    const button = el("button", undefined, { type: "button", "aria-current": String(r.id === state.selected) });
    button.disabled = state.writing;
    button.append(el("span", r.title), el("span", r.state, { class: "chip" }));
    button.addEventListener("click", () => select(r.id));
    const item = el("li");
    item.append(button);
    list.append(item);
  }
  return true;
}

async function renderOutbox(read) {
  const items = await api("/api/outbox");
  if (read !== state.read) return false;
  const list = $("outbox");
  list.replaceChildren();
  for (const item of items) list.append(el("li", `${item.effect} to ${item.recipient}`));
  if (!list.children.length) list.append(el("li", "Empty"));
  return true;
}

function actorRole() {
  const actor = state.app.actors[state.actor];
  return actor ? actor.role : "";
}

function optionRow(o, record) {
  const row = el("div", undefined, { class: "option" });
  const screen = state.app.screens.actions[o.action];
  const button = el("button", (screen && screen.title) || o.action, { type: "button", title: o.action, class: "quiet action-choice" });
  button.dataset.allowed = String(o.allowed);
  button.disabled = !o.allowed || state.writing || !state.fresh;
  button.addEventListener("click", () => openAction(o, record, button));
  row.append(button, el("span", `Next: ${o.to}`, { class: "action-destination" }));
  if (o.role !== actorRole()) row.append(el("span", `for a ${o.role}`, { class: "why" }));
  else if (!o.allowed) row.append(el("span", o.reason, { class: "why" }));
  return row;
}

// Who is acting: the role, and a warning when the actor is inactive, since the kernel refuses every step it tries.
function renderActor() {
  const actor = state.app.actors[state.actor];
  // An AI agent, a timer or an external system has no screens (ADR-0210): it calls this app's API. Acting as one here
  // stands in for those calls, and the server decides them exactly as it decides a click.
  const kind = actor && (state.app.kinds || {})[actor.role], stand = { agent: "AI agent", timer: "timer", system: "external system" }[kind];
  const notes = [actor && !actor.active ? "inactive: every step is refused" : "", stand ? `${stand}: you stand in for its API calls` : ""].filter(Boolean);
  $("actor-role").textContent = actor ? [actor.role, ...notes].join(" · ") : "";
  $("actor-role").className = "role" + (actor && !actor.active ? " warn" : "");
  for (const row of $("rules").children) row.classList.toggle("mine", row.dataset.role === actorRole());
}

// The page opens acting as #actor=<id> when that actor is in the directory (PlayIDE's "Run as", ADR-0215).
function actorFromLink() {
  const wanted = new URLSearchParams(location.hash.slice(1)).get("actor");
  return wanted && wanted in state.app.actors ? wanted : "";
}

async function actAs(id) {
  if (state.writing) return;
  state.actor = id;
  $("actor").value = id;
  $("result").hidden = true;
  $("action-screen").hidden = true;
  renderActor();
  await refreshSafely();
}

async function renderDetail(read) {
  const selected = state.selected, actor = state.actor;
  if (!selected) return true;
  const view = await api(`/api/records/${selected}?actor=${encodeURIComponent(actor)}`);
  if (read !== state.read || selected !== state.selected || actor !== state.actor) return false;
  $("detail-title").textContent = view.record.title;
  $("record-state").hidden = false;
  $("current-state").textContent = view.record.state;
  const values = $("detail-fields");
  values.replaceChildren();
  const labels = Object.fromEntries(screenFields(state.app.screens.create).map((a) => [a.name, a.label]));
  for (const [name, value] of Object.entries(view.record.fields || {})) values.append(el("dt", labels[name] || name), el("dd", String(value)));
  $("action-screen").hidden = true;
  $("stranded").hidden = view.record.current_model;
  const flow = $("flow");
  flow.replaceChildren();
  for (const s of state.app.states) flow.append(el("li", s, s === view.record.state ? { "aria-current": "step" } : {}));
  // The acting role's screens come first; the screens of other roles are folded away, as that role would never see
  // them. The server still says, for each one, whether this actor may act and why not.
  const options = $("options"), role = actorRole();
  options.replaceChildren();
  const mine = view.options.filter((o) => o.role === role), others = view.options.filter((o) => o.role !== role);
  for (const o of mine) options.append(optionRow(o, view.record));
  if (!mine.length) options.append(el("p", view.options.length ? `Nothing for a ${role} to do in ${view.record.state}.` : "No further actions from this state.", { class: "muted" }));
  if (others.length) {
    const fold = el("details", undefined, { class: "others" });
    fold.append(el("summary", `For other roles (${others.length})`));
    for (const o of others) fold.append(optionRow(o, view.record));
    options.append(fold);
  }
  const history = $("history");
  history.replaceChildren();
  for (const h of view.history) history.append(el("li", `${h.effect} by ${h.actor}, now ${h.state}`));
  if (!view.history.length) history.append(el("li", "Created"));
  return true;
}

async function refresh() {
  // A later role or record selection owns the view. A failed read keeps inspection data,
  // but never restores stale action buttons; reloading only reads, it does not retry writes.
  const read = ++state.read;
  state.fresh = false;
  setWriting(state.writing);
  try {
    if (!await renderRecords(read) || !await renderDetail(read) || !await renderOutbox(read)) return false;
    if (read !== state.read) return false;
    state.fresh = true;
    return true;
  } finally {
    if (read === state.read) setWriting(state.writing);
  }
}

async function select(id) {
  if (state.writing) return;
  state.selected = id;
  $("result").hidden = true;
  if (await refreshSafely()) $("detail-title").focus();
}

async function act(action, record) {
  if (state.writing || !state.fresh) return;
  const actor = state.actor, operationId = crypto.randomUUID();
  const attempt = runtimeAttempt(action, record, operationId);
  setWriting(true);
  try {
    const result = await api(`/api/records/${record.id}/act`, {
      action, actor, expected_version: record.version, operation_id: operationId });
    say(`${action} ${result.duplicate ? "already recorded" : "completed"}. State: ${result.record.state}.`, "ok");
    runtimeOutcome(attempt, result);
  } catch (error) {
    say(error.code ? refusal(error) : `Action result was not confirmed: ${error.message}. Review the refreshed record and history before trying again.`, "bad");
    runtimeOutcome(attempt, null, error);
  } finally {
    await refreshSafely();
    setWriting(false);
    $("result").focus();
  }
}

async function start() {
  state.app = await api("/api/app");
  runtimeReady();
  document.title = state.app.name;
  $("app-name").textContent = state.app.name;
  $("app-description").textContent = state.app.description || "Your model, running locally.";
  $("model-hash").textContent = state.app.model_hash.slice(0, 12);
  $("model-hash").title = state.app.model_hash;
  const picker = $("actor");
  picker.replaceChildren();
  for (const [id, a] of Object.entries(state.app.actors)) {
    picker.append(el("option", `${a.role} · ${id}${a.active ? "" : " · inactive"}`, { value: id }));
  }
  state.actor = actorFromLink() || picker.value;
  picker.value = state.actor;
  renderRules();
  renderActor();
  renderFields();
  await refresh();
  setWriting(false);
  $("load-feedback").hidden = true;
}

$("actor").addEventListener("change", () => actAs($("actor").value));
window.addEventListener("hashchange", () => {
  if (!state.app || state.writing || !state.fresh) return;
  const id = actorFromLink();
  if (id) actAs(id);
});
$("create").addEventListener("input", () => {
  $("create-feedback").hidden = true;
  $("title").removeAttribute("aria-invalid");
  $("title").removeAttribute("aria-describedby");
});
$("create").addEventListener("submit", async (event) => {
  event.preventDefault();
  if (!state.app || state.writing || !state.fresh) return;
  $("create-feedback").hidden = true;
  setWriting(true);
  let record;
  try {
    record = await api("/api/records", { title: $("title").value, actor: state.actor, fields: fieldValues() });
  } catch (error) {
    say(error.code ? refusal(error) : `Create result was not confirmed: ${error.message}. Review the latest records before trying again.`, "bad", "create-feedback");
    if (error.code === "INVALID_TITLE") {
      $("title").setAttribute("aria-invalid", "true");
      $("title").setAttribute("aria-describedby", "create-feedback");
    }
    if (!error.code) await refreshSafely();
  }
  if (record) {
    $("create").reset();
    state.selected = record.id;
    say(`Created in ${record.state}.`, "ok");
    await refreshSafely();
  }
  setWriting(false);
  $(record ? "result" : "create-feedback").focus();
});
$("retry-load").addEventListener("click", async () => {
  if (state.writing) return;
  $("retry-load").disabled = true;
  try {
    if (state.app) {
      if (!await refresh()) return;
    } else await start();
    setWriting(false);
    $("load-feedback").hidden = true;
    $("actor").focus();
  } catch (error) {
    showLoadError(error);
  } finally {
    $("retry-load").disabled = false;
  }
});

trackBarHeight();
start().catch(showLoadError);
