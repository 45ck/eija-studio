// Generated by EIJA Studio. Every decision is made by the server; this page only shows what it says.
"use strict";
const $ = (id) => document.getElementById(id);
const state = { app: null, actor: "", selected: "" };

function el(tag, text, attrs = {}) {
  const node = document.createElement(tag);
  if (text !== undefined) node.textContent = text;
  for (const [k, v] of Object.entries(attrs)) node.setAttribute(k, v);
  return node;
}

async function api(path, body) {
  const options = body === undefined ? {} : { method: "POST", headers: { "Content-Type": "application/json" }, body: JSON.stringify(body) };
  const response = await fetch(path, options);
  const value = await response.json();
  if (!response.ok) throw Object.assign(new Error(value.message || "Refused"), { code: value.code });
  return value;
}

function refusal(error) {
  return error.code ? `Refused (${error.code}): ${error.message}` : `Something went wrong: ${error.message}`;
}

function say(text, kind) {
  const box = $("result");
  box.hidden = false;
  box.className = "notice " + kind;
  box.textContent = text;
}

function renderRules() {
  const body = $("rules");
  body.replaceChildren();
  for (const [action, t] of Object.entries(state.app.transitions)) {
    const row = el("tr", undefined, { "data-role": t.role });
    for (const text of [action, t.from, t.to, t.role]) row.append(el("td", text));
    body.append(row);
  }
}

// The record's attributes come from the data model (class diagram); the server checks every value.
// Which ones the form asks for, in what order and under what label, comes from the create screen (ADR-0154).
function attribute(name) {
  return state.app.record.attributes.find((a) => a.name === name);
}

function screenFields(screen) {
  if (!state.app.record || !screen) return [];
  return screen.fields.map((f) => ({ ...attribute(f.attribute), label: f.label || f.attribute }));
}

// Each action has its own screen: its title, the record values it shows (in its order, under its labels) and its
// button. Choosing an action opens it; the action runs only when its button is pressed, and the kernel decides.
function openAction(option, record) {
  const screen = state.app.screens.actions[option.action] || { title: option.action, fields: [], button: option.action };
  const box = $("action-screen");
  box.hidden = false;
  box.replaceChildren(el("h3", screen.title));
  const values = el("dl", undefined, { class: "values" });
  for (const a of screenFields(screen)) values.append(el("dt", a.label), el("dd", a.name in record.fields ? String(record.fields[a.name]) : "—"));
  const go = el("button", `${screen.button || option.action} → ${option.to}`, { type: "button" });
  go.addEventListener("click", () => { box.hidden = true; act(option.action, record.version); });
  // Close, never Cancel: a workflow may have an action of that name, and this button only closes the screen.
  const close = el("button", "Close", { type: "button", class: "quiet" });
  close.addEventListener("click", () => { box.hidden = true; });
  const row = el("div", undefined, { class: "option" });
  row.append(go, close);
  box.append(values, row);
  go.focus();
}

function renderFields() {
  const box = $("fields");
  box.replaceChildren();
  const create = state.app.screens.create;
  if (create) {
    $("create-title").textContent = create.title;
    $("create-button").textContent = create.button || "Create";
  }
  for (const a of screenFields(create)) {
    const id = "field-" + a.name, label = el("label", a.label + (a.required ? " *" : ""), { for: id });
    let input;
    if (a.type === "choice") {
      input = el("select", undefined, { id });
      input.append(el("option", "", { value: "" }), ...a.choices.map((c) => el("option", c, { value: c })));
    } else if (a.type === "boolean") {
      input = el("input", undefined, { id, type: "checkbox" });
    } else {
      input = el("input", undefined, { id, type: { number: "number", date: "date" }[a.type] || "text" });
      if (a.type === "text") input.maxLength = a.max_length;
      if (a.type === "number") input.step = "any";
    }
    if (a.required && a.type !== "boolean") input.required = true;
    box.append(label, input);
  }
}

function fieldValues() {
  const values = {};
  for (const a of screenFields(state.app.screens.create)) {
    const input = $("field-" + a.name);
    if (a.type === "boolean") values[a.name] = input.checked;
    else if (input.value === "") continue;
    else values[a.name] = a.type === "number" ? Number(input.value) : input.value;
  }
  return values;
}

async function renderRecords() {
  const records = await api("/api/records");
  const list = $("records");
  list.replaceChildren();
  $("empty").hidden = records.length > 0;
  for (const r of records) {
    const button = el("button", undefined, { type: "button", "aria-current": String(r.id === state.selected) });
    button.append(el("span", r.title), el("span", r.state, { class: "chip" }));
    button.addEventListener("click", () => select(r.id));
    const item = el("li");
    item.append(button);
    list.append(item);
  }
}

async function renderOutbox() {
  const list = $("outbox");
  list.replaceChildren();
  for (const item of await api("/api/outbox")) list.append(el("li", `${item.effect} to ${item.recipient}`));
  if (!list.children.length) list.append(el("li", "Empty"));
}

function actorRole() {
  const actor = state.app.actors[state.actor];
  return actor ? actor.role : "";
}

function optionRow(o, record) {
  const row = el("div", undefined, { class: "option" });
  const screen = state.app.screens.actions[o.action];
  const button = el("button", `${(screen && screen.title) || o.action} → ${o.to}`, { type: "button", title: o.action });
  button.disabled = !o.allowed;
  button.addEventListener("click", () => openAction(o, record));
  row.append(button);
  if (o.role !== actorRole()) row.append(el("span", `for a ${o.role}`, { class: "why" }));
  else if (!o.allowed) row.append(el("span", o.reason, { class: "why" }));
  return row;
}

// Who is acting: the role, and a warning when the actor is inactive, since the kernel refuses every step it tries.
function renderActor() {
  const actor = state.app.actors[state.actor];
  // An AI agent, a timer or an external system has no screens (ADR-0210): it calls this app's API. Acting as one here
  // stands in for those calls, and the server decides them exactly as it decides a click.
  const kind = actor && (state.app.kinds || {})[actor.role], stand = { agent: "AI agent", timer: "timer", system: "external system" }[kind];
  const notes = [actor && !actor.active ? "inactive: every step is refused" : "", stand ? `${stand}: you stand in for its API calls` : ""].filter(Boolean);
  $("actor-role").textContent = actor ? [actor.role, ...notes].join(" · ") : "";
  $("actor-role").className = "role" + (actor && !actor.active ? " warn" : "");
  for (const row of $("rules").children) row.classList.toggle("mine", row.dataset.role === actorRole());
}

// The page opens acting as #actor=<id> when that actor is in the directory (PlayIDE's "Run as", ADR-0215).
function actorFromLink() {
  const wanted = new URLSearchParams(location.hash.slice(1)).get("actor");
  return wanted && wanted in state.app.actors ? wanted : "";
}

async function actAs(id) {
  state.actor = id;
  $("actor").value = id;
  $("result").hidden = true;
  renderActor();
  await renderDetail();
}

async function renderDetail() {
  if (!state.selected) return;
  const view = await api(`/api/records/${state.selected}?actor=${encodeURIComponent(state.actor)}`);
  $("detail-title").textContent = view.record.title;
  const values = $("detail-fields");
  values.replaceChildren();
  const labels = Object.fromEntries(screenFields(state.app.screens.create).map((a) => [a.name, a.label]));
  for (const [name, value] of Object.entries(view.record.fields || {})) values.append(el("dt", labels[name] || name), el("dd", String(value)));
  $("action-screen").hidden = true;
  $("stranded").hidden = view.record.current_model;
  const flow = $("flow");
  flow.replaceChildren();
  for (const s of state.app.states) flow.append(el("li", s, s === view.record.state ? { "aria-current": "step" } : {}));
  // The acting role's screens come first; the screens of other roles are folded away, as that role would never see
  // them. The server still says, for each one, whether this actor may act and why not.
  const options = $("options"), role = actorRole();
  options.replaceChildren();
  const mine = view.options.filter((o) => o.role === role), others = view.options.filter((o) => o.role !== role);
  for (const o of mine) options.append(optionRow(o, view.record));
  if (!mine.length) options.append(el("p", view.options.length ? `Nothing for a ${role} to do in ${view.record.state}.` : `Nothing leaves ${view.record.state}.`, { class: "muted" }));
  if (others.length) {
    const fold = el("details", undefined, { class: "others" });
    fold.append(el("summary", `For other roles (${others.length})`));
    for (const o of others) fold.append(optionRow(o, view.record));
    options.append(fold);
  }
  const history = $("history");
  history.replaceChildren();
  for (const h of view.history) history.append(el("li", `${h.effect} by ${h.actor}, now ${h.state}`));
  if (!view.history.length) history.append(el("li", "Created"));
}

async function refresh() {
  await renderRecords();
  await renderDetail();
  await renderOutbox();
}

async function select(id) {
  state.selected = id;
  $("result").hidden = true;
  await refresh();
}

async function act(action, version) {
  try {
    const result = await api(`/api/records/${state.selected}/act`, {
      action, actor: state.actor, expected_version: version, operation_id: crypto.randomUUID() });
    say(`${action} done. Now ${result.record.state}.`, "ok");
  } catch (error) {
    say(refusal(error), "bad");
  }
  await refresh();
}

async function start() {
  state.app = await api("/api/app");
  document.title = state.app.name;
  $("app-name").textContent = state.app.name;
  $("model-hash").textContent = state.app.model_hash.slice(0, 12);
  $("model-hash").title = state.app.model_hash;
  const picker = $("actor");
  for (const [id, a] of Object.entries(state.app.actors)) {
    picker.append(el("option", `${id} (${a.role}${a.active ? "" : ", inactive"})`, { value: id }));
  }
  state.actor = actorFromLink() || picker.value;
  picker.value = state.actor;
  picker.addEventListener("change", () => actAs(picker.value));
  window.addEventListener("hashchange", () => { const id = actorFromLink(); if (id) actAs(id); });
  $("create").addEventListener("submit", async (event) => {
    event.preventDefault();
    try {
      const record = await api("/api/records", { title: $("title").value, actor: state.actor, fields: fieldValues() });
      $("create").reset();
      await select(record.id);
      say(`Created in ${record.state}.`, "ok");
    } catch (error) {
      say(refusal(error), "bad");
    }
  });
  renderRules();
  renderActor();
  renderFields();
  await refresh();
}

start();
