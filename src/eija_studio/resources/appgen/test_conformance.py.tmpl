"""Generated by EIJA Studio. Conformance: this app, through its own storage, must commit and refuse exactly where the
EIJA kernel does on an in-memory session.

tests/oracle.json holds the kernel's answer for every state x action x actor x expected version (and every replay, with
the audit entries and notifications each commit writes), the data model's answer for record values that are valid, at
the edge of a rule, missing, of the wrong type, too long or unknown, who may start a record and where it starts, a run
from a new record to each transition, and the actions offered to each actor in each state. The same cases are sent
through the app's HTTP API. It was computed by running EIJA's runtime, not by reading this app. Do not edit either
file: rebuild from the model.
"""
from __future__ import annotations

import http.client
import json
import threading
import unittest
from http.server import ThreadingHTTPServer
from pathlib import Path

from app import service
from app.build_identity import current_subject
from eija_studio.domain.screens import check_screens

ORACLE = json.loads((Path(__file__).resolve().parent / "oracle.json").read_text(encoding="utf-8"))


VALID = ORACLE["data_cases"][0]["fields"] if ORACLE.get("data_cases") else None  # the oracle's valid record


def seed(svc: service.Service, state: str, values: dict | None = None, record_id: str = "r1") -> str:
    """A record already in `state` (holding `values`), written directly so the case starts where the oracle's did."""
    svc.db.execute("INSERT INTO records(id,case_id,model_hash,state,version,fields,data_digest) VALUES(?,?,?,?,0,?,?)",
                   (record_id, service.CASE, service.MODEL.semantic_hash, state, json.dumps(values or {}), service.DATA_DIGEST))
    return record_id


def stock(svc: service.Service) -> service.Service:
    """The objects the oracle's records refer to (ADR-0235), stored so a reference field can name them."""
    for item in ORACLE.get("objects", []):
        svc.db.execute("INSERT INTO objects VALUES(?,?,?,'oracle')", (item["id"], item["class"], json.dumps(item["fields"])))
    return svc


def written(svc: service.Service, record_id: str, actor: str) -> dict:
    """What the app has written for one record: its audit entries in order, and its outbox rows as (effect, recipient)."""
    return {"audit": [step["effect"] for step in svc.view(record_id, actor)["history"]],
            "outbox": [[row["effect"], row["recipient"]] for row in svc.outbox() if row["record_id"] == record_id]}


def created(svc: service.Service, actor: str, fields: dict | None, title: str = "Conformance") -> dict:
    try:
        record = svc.create(title, actor, fields)
    except service.Refused as refused:
        return {"outcome": "REFUSED", "code": refused.code}
    return {"outcome": "CREATED", "state": record["state"], "version": record["version"]}


def observe(svc: service.Service, record_id: str, case: dict, operation: str = "op-1") -> dict:
    try:
        result = svc.act(record_id, case["actor"], case["action"], case["expected_version"], operation)
    except service.Refused as refused:
        return {"outcome": "REFUSED", "code": refused.code}
    if result["duplicate"]:
        return {"outcome": "DUPLICATE", "state": result["record"]["state"]}
    return {"outcome": "COMMITTED", "state": result["record"]["state"], "effects": result["effects"]}


class Conformance(unittest.TestCase):
    @classmethod
    def setUpClass(cls):
        cls.subject = current_subject()

    @classmethod
    def tearDownClass(cls):
        current_subject(cls.subject)

    def test_built_from_the_same_model(self):
        self.assertEqual(service.MODEL.semantic_hash, ORACLE["model_hash"])

    def test_every_case_matches_the_kernel(self):
        self.assertTrue(ORACLE["cases"])
        for case in ORACLE["cases"]:
            with self.subTest(**{k: case[k] for k in ("state", "action", "actor", "expected_version")}):
                svc = service.Service()
                record_id = seed(svc, case["state"])
                self.assertEqual(observe(svc, record_id, case), case["expect"])
                if "replay" in case:
                    self.assertEqual(observe(svc, record_id, case), case["replay"])

    def test_screens_pass_the_design_check(self):
        """The screens built in are the ones the oracle was made with, and every use case's screen can be used."""
        self.assertEqual(service.SCREENS.digest, ORACLE["screens_digest"])
        self.assertEqual(check_screens(service.SCREENS, service.MODEL, service.DATA), [])

    def test_record_values_are_checked_by_the_data_model(self):
        """Each data case through the app's create: kept exactly as the data model cleans it, or refused with its code."""
        self.assertEqual(bool(ORACLE.get("data_cases")), service.DATA is not None)
        for case in ORACLE.get("data_cases", []):
            with self.subTest(case=case["name"]):
                svc = stock(service.Service())
                try:
                    record = svc.create("Data case", case["actor"], case["fields"])
                except service.Refused as refused:
                    self.assertEqual({"outcome": "REFUSED", "code": refused.code}, case["expect"])
                else:
                    self.assertEqual({"outcome": "CREATED", "fields": record["fields"]}, case["expect"])
                    self.assertEqual(svc.records()[0]["fields"], case["expect"]["fields"])

    def test_only_the_named_roles_start_records(self):
        """When the model names who may start a record, every other active actor is refused (ADR-0231)."""
        self.assertEqual(bool(ORACLE.get("start_cases")), bool(service.MODEL.initiators))
        for case in ORACLE.get("start_cases", []):
            with self.subTest(actor=case["actor"]):
                svc = stock(service.Service())
                fields = ORACLE["data_cases"][0]["fields"] if ORACLE.get("data_cases") else None
                try:
                    svc.create("Start case", case["actor"], fields)
                except service.Refused as refused:
                    self.assertEqual({"outcome": "REFUSED", "code": refused.code}, case["expect"])
                else:
                    self.assertEqual({"outcome": "CREATED"}, case["expect"])

    def test_one_actor_never_takes_two_separated_actions(self):
        """An actor who took one action of a separation-of-duties law gets the kernel's answer for another (ADR-0233)."""
        if not any(law.kind == "distinct_actors" for law in service.PACK.laws):
            self.assertNotIn("separation_cases", ORACLE)
        for case in ORACLE.get("separation_cases", []):
            with self.subTest(actor=case["actor"], first=case["first"], then=case["then"]):
                svc = service.Service()
                record_id = seed(svc, case["state"])
                svc.act(record_id, case["actor"], case["first"], 0, "op-1")
                second = {"actor": case["actor"], "action": case["then"], "expected_version": 1}
                offered = next(o for o in svc.view(record_id, case["actor"])["options"] if o["action"] == case["then"])
                self.assertEqual((offered["allowed"], offered.get("code")),
                                 (case["expect"]["outcome"] == "COMMITTED", case["expect"].get("code")))
                self.assertEqual(observe(svc, record_id, second, "op-2"), case["expect"])

    def test_guards_over_record_values_match_the_kernel(self):
        """A record's values decide a guarded transition exactly as the kernel decides it (ADR-0234)."""
        if not any(t.conditions for t in service.MODEL.transitions):
            self.assertNotIn("value_cases", ORACLE)
        for case in ORACLE.get("value_cases", []):
            with self.subTest(action=case["action"], values=case["values"]):
                svc = service.Service()
                record_id = seed(svc, case["state"], case["values"])
                attempt = {"actor": case["actor"], "action": case["action"], "expected_version": 0}
                offered = next(o for o in svc.view(record_id, case["actor"])["options"] if o["action"] == case["action"])
                self.assertEqual((offered["allowed"], offered.get("code")),
                                 (case["expect"]["outcome"] == "COMMITTED", case["expect"].get("code")))
                self.assertEqual(observe(svc, record_id, attempt), case["expect"])

    def test_records_from_another_data_model_are_refused(self):
        """A record whose values another data model checked is never acted on: its values may not fit this one."""
        case = next(c for c in ORACLE["cases"] if c["expect"]["outcome"] == "COMMITTED")
        svc = service.Service()
        record_id = seed(svc, case["state"])
        svc.db.execute("UPDATE records SET data_digest='an-earlier-data-model' WHERE id=?", (record_id,))
        self.assertFalse(svc.view(record_id, case["actor"])["record"]["current_model"])
        self.assertEqual(observe(svc, record_id, case), {"outcome": "REFUSED", "code": "STALE_DATA"})

    def test_effects_are_written_once(self):
        """Each commit writes exactly the kernel's audit entries and notifications (to the kernel's recipient, naming
        this record), and its replay writes nothing more."""
        for case in ORACLE["cases"]:
            if case["expect"]["outcome"] != "COMMITTED":
                continue
            with self.subTest(state=case["state"], action=case["action"], actor=case["actor"]):
                svc = service.Service()
                record_id = seed(svc, case["state"])
                observe(svc, record_id, case)
                observe(svc, record_id, case)
                self.assertEqual(written(svc, record_id, case["actor"]), case["written"])
                self.assertEqual({row["record_id"] for row in svc.outbox()}, {record_id} if case["written"]["outbox"] else set())

    def test_records_start_where_the_model_starts(self):
        """Every actor starting a record with valid values: refused as the kernel refuses them, or given a record in the
        model's initial state at version 0."""
        self.assertTrue(ORACLE["create_cases"])
        for case in ORACLE["create_cases"]:
            with self.subTest(actor=case["actor"]):
                self.assertEqual(created(stock(service.Service()), case["actor"], VALID), case["expect"])

    def test_each_transition_is_reached_from_a_new_record(self):
        """A record the app itself creates is walked to each transition; every step, and what it writes, is the
        kernel's, and a second record created beside it is never touched."""
        creator = next(c["actor"] for c in ORACLE["create_cases"] if c["expect"]["outcome"] == "CREATED")
        for journey in ORACLE["journeys"]:
            with self.subTest(transition=journey["transition"]):
                svc = stock(service.Service())
                record_id = svc.create("Journey", creator, VALID)["id"]
                bystander = svc.create("Bystander", creator, VALID)
                for n, step in enumerate(journey["steps"], start=1):
                    before = written(svc, record_id, step["actor"])
                    self.assertEqual(observe(svc, record_id, step, f"op-{n}"), step["expect"])
                    after = written(svc, record_id, step["actor"])
                    self.assertEqual({k: after[k][len(before[k]):] for k in after}, step["written"])
                untouched = svc.view(bystander["id"], creator)
                self.assertEqual((untouched["record"]["state"], untouched["record"]["version"], untouched["history"]),
                                 (bystander["state"], 0, []))
                self.assertFalse([row for row in svc.outbox() if row["record_id"] == bystander["id"]])

    def test_offered_actions_match_the_kernel(self):
        """The actions the app offers each actor in each state, and why one is not allowed, are what the kernel does."""
        for case in ORACLE["options_cases"]:
            with self.subTest(state=case["state"], actor=case["actor"]):
                svc = service.Service()
                record_id = seed(svc, case["state"], VALID)
                offered = [{"action": o["action"], "allowed": o["allowed"]} | ({"code": o["code"]} if "code" in o else {})
                           for o in svc.view(record_id, case["actor"])["options"]]
                self.assertEqual(offered, case["options"])

    def test_the_rules_shown_are_the_model(self):
        """The rule table the app shows: each action, every state it leaves, where it leads and who takes it."""
        from app import server
        self.assertEqual(server.describe()["transitions"], ORACLE["rules"])
        self.assertEqual(server.describe()["initial_state"], next(
            (c["expect"]["state"] for c in ORACLE["create_cases"] if c["expect"]["outcome"] == "CREATED"), server.MODEL.initial_state))

    def test_the_http_api_answers_as_the_kernel_does(self):
        """Every case again, through the app's HTTP API: a commit is a success carrying the kernel's state and
        effects, a refusal an error carrying the kernel's code; starting a record is refused or created alike; and each
        journey runs from a record created over HTTP, one operation id per step."""
        from app import server
        httpd = ThreadingHTTPServer(("127.0.0.1", 0), server.handler_for(service.Service()))
        threading.Thread(target=httpd.serve_forever, daemon=True).start()
        connection = http.client.HTTPConnection("127.0.0.1", httpd.server_address[1], timeout=30)

        def post(path: str, body: dict) -> tuple[int, dict]:
            connection.request("POST", path, json.dumps(body), {"Content-Type": "application/json"})
            response = connection.getresponse()
            return response.status, json.loads(response.read())

        def answer(status: int, body: dict) -> dict:
            if status >= 400:
                return {"outcome": "REFUSED", "code": body.get("code")}
            if status != 200 or body.get("duplicate"):
                return {"outcome": "DUPLICATE" if body.get("duplicate") else str(status), "state": body["record"]["state"]}
            return {"outcome": "COMMITTED", "state": body["record"]["state"], "effects": body["effects"]}

        try:
            for case in ORACLE["cases"]:
                with self.subTest(**{k: case[k] for k in ("state", "action", "actor", "expected_version")}):
                    svc = service.Service()
                    record_id = seed(svc, case["state"], record_id="a1")
                    httpd.RequestHandlerClass = server.handler_for(svc)
                    request = {"actor": case["actor"], "action": case["action"],
                               "expected_version": case["expected_version"], "operation_id": "op-http"}
                    self.assertEqual(answer(*post(f"/api/records/{record_id}/act", request)), case["expect"])
                    if "replay" in case:
                        self.assertEqual(answer(*post(f"/api/records/{record_id}/act", request)), case["replay"])
                    svc.db.close()
            for case in ORACLE["create_cases"]:
                with self.subTest(create=case["actor"]):
                    svc = stock(service.Service())
                    httpd.RequestHandlerClass = server.handler_for(svc)
                    status, body = post("/api/records", {"title": "Over HTTP", "actor": case["actor"], "fields": VALID or {}})
                    svc.db.close()
                    got = ({"outcome": "CREATED", "state": body["state"], "version": body["version"]} if status == 201
                           else {"outcome": "REFUSED", "code": body.get("code")})
                    self.assertEqual(got, case["expect"])
            creator = next(c["actor"] for c in ORACLE["create_cases"] if c["expect"]["outcome"] == "CREATED")
            for journey in ORACLE["journeys"]:
                with self.subTest(transition=journey["transition"]):
                    svc = stock(service.Service())
                    httpd.RequestHandlerClass = server.handler_for(svc)
                    record_id = post("/api/records", {"title": "Journey", "actor": creator, "fields": VALID or {}})[1]["id"]
                    for n, step in enumerate(journey["steps"], start=1):
                        request = {"actor": step["actor"], "action": step["action"],
                                   "expected_version": step["expected_version"], "operation_id": f"op-{n}"}
                        self.assertEqual(answer(*post(f"/api/records/{record_id}/act", request)), step["expect"])
                    svc.db.close()
        finally:
            connection.close()
            httpd.shutdown()
            httpd.server_close()


if __name__ == "__main__":
    unittest.main()
