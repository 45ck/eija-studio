"""Generated by EIJA Studio. Conformance: this app must commit and refuse exactly where the EIJA kernel does.

tests/oracle.json holds the kernel's answer for every state x action x actor x expected version (and every replay).
It was computed by running EIJA's runtime, not by reading this app. Do not edit either file: rebuild from the model.
"""
from __future__ import annotations

import json
import unittest
from pathlib import Path

from app import service, spec

ORACLE = json.loads((Path(__file__).resolve().parent / "oracle.json").read_text(encoding="utf-8"))


def seed(svc: service.Service, state: str) -> str:
    """A record already in `state`, written directly so the case starts exactly where the oracle's did."""
    svc.db.execute("INSERT INTO records VALUES('r1','case',?,0,'oracle',?)", (state, spec.MODEL_HASH))
    return "r1"


def observe(svc: service.Service, record_id: str, case: dict) -> dict:
    try:
        result = svc.act(record_id, case["actor"], case["action"], case["expected_version"], "op-1")
    except service.Refused as refused:
        return {"outcome": "REFUSED", "code": refused.code}
    if result["duplicate"]:
        return {"outcome": "DUPLICATE", "state": result["record"]["state"]}
    return {"outcome": "COMMITTED", "state": result["record"]["state"], "effects": result["effects"]}


class Conformance(unittest.TestCase):
    def test_built_from_the_same_model(self):
        self.assertEqual(spec.MODEL_HASH, ORACLE["model_hash"])

    def test_every_case_matches_the_kernel(self):
        self.assertTrue(ORACLE["cases"])
        for case in ORACLE["cases"]:
            with self.subTest(**{k: case[k] for k in ("state", "action", "actor", "expected_version")}):
                svc = service.Service()
                record_id = seed(svc, case["state"])
                self.assertEqual(observe(svc, record_id, case), case["expect"])
                if "replay" in case:
                    self.assertEqual(observe(svc, record_id, case), case["replay"])

    def test_effects_are_written_once(self):
        for case in ORACLE["cases"]:
            if case["expect"]["outcome"] != "COMMITTED":
                continue
            svc = service.Service()
            record_id = seed(svc, case["state"])
            observe(svc, record_id, case)
            observe(svc, record_id, case)
            written = [r["effect"] for r in svc.view(record_id, case["actor"])["history"]] + [r["effect"] for r in svc.outbox()]
            self.assertEqual(sorted(written), sorted(case["expect"]["effects"]))


if __name__ == "__main__":
    unittest.main()
