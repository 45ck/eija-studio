"""Generated build identity checks shared by application startup and conformance."""
from __future__ import annotations

import json
from pathlib import Path

from eija_studio.application.build_subject import SUBJECT_FILE, checked_build_subject
from eija_studio.bootstrap import implementation_manifest
from eija_studio.domain.models import DomainError, fingerprint

ROOT = Path(__file__).resolve().parents[1]


def current_subject(expected=None):
    """Read actual payload bytes and bind them to the installed implementation."""
    envelope_text = (ROOT / SUBJECT_FILE).read_bytes().decode("utf-8")
    envelope = json.loads(envelope_text)
    paths = envelope["payload_paths"]
    if any(Path(path).is_absolute() or ".." in Path(path).parts for path in paths):
        raise DomainError("BUILD_SUBJECT_INVALID", "Build payload paths must stay within the generated application")
    payload = {path: (ROOT / path).read_bytes().decode("utf-8") for path in paths}
    actual = {path.relative_to(ROOT).as_posix() for path in ROOT.rglob("*")
              if path.is_file() and not any(part in ("data", "__pycache__") for part in path.relative_to(ROOT).parts)}
    if actual - {"BUILD.json"} != set(paths) | {SUBJECT_FILE}:
        raise DomainError("BUILD_SUBJECT_MISMATCH", "Generated file inventory differs from this build")
    return checked_build_subject(payload | {SUBJECT_FILE: envelope_text},
                                 implementation_digest=fingerprint(implementation_manifest()), expected_subject=expected)
