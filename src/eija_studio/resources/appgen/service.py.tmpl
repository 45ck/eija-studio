"""Generated by EIJA Studio. The app's rules: the same checks, in the same order, as the EIJA kernel.

Do not edit. The behaviour comes from app/spec.py, which is generated from the model, and tests/ check every
state, action and actor against the kernel's own answers.
"""
from __future__ import annotations

import json
import sqlite3
import threading
import uuid
from hashlib import sha256
from typing import Any

from . import spec

SCHEMA = """
CREATE TABLE IF NOT EXISTS records(id TEXT PRIMARY KEY, title TEXT NOT NULL, state TEXT NOT NULL,
    version INTEGER NOT NULL, created_by TEXT NOT NULL, model_hash TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS operations(id TEXT PRIMARY KEY, binding TEXT NOT NULL, result TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS audit(seq INTEGER PRIMARY KEY AUTOINCREMENT, record_id TEXT NOT NULL, effect TEXT NOT NULL,
    actor TEXT NOT NULL, action TEXT NOT NULL, from_state TEXT NOT NULL, to_state TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS outbox(id TEXT PRIMARY KEY, record_id TEXT NOT NULL, effect TEXT NOT NULL,
    recipient TEXT NOT NULL);
"""


class Refused(Exception):
    """A request the model does not allow. `code` matches the EIJA kernel's refusal code."""

    def __init__(self, code: str, message: str):
        super().__init__(message)
        self.code, self.message = code, message


def _canonical(value: Any) -> str:
    return json.dumps(value, sort_keys=True, separators=(",", ":"), ensure_ascii=False)


def transition(action: str) -> dict[str, Any]:
    found = spec.TRANSITIONS.get(action)
    if found is None:
        raise Refused("ACTION_DENIED", "Action is not modelled")
    return found


def actor(actor_id: str) -> dict[str, Any]:
    found = spec.ACTORS.get(actor_id)
    if found is None:
        raise Refused("UNKNOWN_ACTOR", "Actor is not in the directory")
    return found


def check_actor(who: dict[str, Any], step: dict[str, Any]) -> None:
    if not who["active"]:
        raise Refused("ACTOR_REVOKED", "Actor is not active")
    if who["role"] != step["role"]:
        raise Refused("ROLE_DENIED", f"Only {step['role']} may do this")
    if "actor_assigned" in step["guards"] and not who["assigned"]:
        raise Refused("ASSIGNMENT_DENIED", "Actor is not assigned")


def options(state: str, actor_id: str) -> list[dict[str, Any]]:
    """The actions leaving `state`, each with whether this actor may take it and, if not, why."""
    result = []
    for action, step in spec.TRANSITIONS.items():
        if step["from"] != state:
            continue
        try:
            check_actor(actor(actor_id), step)
            result.append({"action": action, "to": step["to"], "role": step["role"], "allowed": True})
        except Refused as refused:
            result.append({"action": action, "to": step["to"], "role": step["role"], "allowed": False,
                           "code": refused.code, "reason": refused.message})
    return result


class Service:
    """All writes for one request commit together or not at all."""

    def __init__(self, path: str = ":memory:"):
        self.db = sqlite3.connect(path, check_same_thread=False, isolation_level=None)
        self.db.row_factory = sqlite3.Row
        self.lock = threading.Lock()
        self.db.executescript(SCHEMA)

    def _write(self, work):
        with self.lock:
            self.db.execute("BEGIN IMMEDIATE")
            try:
                result = work()
            except BaseException:
                self.db.execute("ROLLBACK")
                raise
            self.db.execute("COMMIT")
            return result

    def _record(self, record_id: str) -> dict[str, Any]:
        row = self.db.execute("SELECT * FROM records WHERE id=?", (record_id,)).fetchone()
        if row is None:
            raise Refused("NOT_FOUND", "No such record")
        record = dict(row)
        record["known_state"] = record["state"] in spec.STATES
        return record

    def create(self, title: str, actor_id: str) -> dict[str, Any]:
        title = title.strip()
        if not 1 <= len(title) <= 200:
            raise Refused("INVALID_TITLE", "Give a title of 1 to 200 characters")
        if not actor(actor_id)["active"]:
            raise Refused("ACTOR_REVOKED", "Actor is not active")
        record_id = uuid.uuid4().hex[:12]

        def work():
            self.db.execute("INSERT INTO records VALUES(?,?,?,?,?,?)",
                            (record_id, title, spec.INITIAL_STATE, 0, actor_id, spec.MODEL_HASH))
            return self._record(record_id)
        return self._write(work)

    def records(self) -> list[dict[str, Any]]:
        ids = [row[0] for row in self.db.execute("SELECT id FROM records ORDER BY rowid DESC")]
        return [self._record(record_id) for record_id in ids]

    def view(self, record_id: str, actor_id: str) -> dict[str, Any]:
        record = self._record(record_id)
        history = [dict(r) for r in self.db.execute(
            "SELECT * FROM audit WHERE record_id=? ORDER BY seq", (record_id,))]
        return {"record": record, "history": history, "options": options(record["state"], actor_id)}

    def outbox(self) -> list[dict[str, Any]]:
        return [dict(r) for r in self.db.execute("SELECT * FROM outbox ORDER BY rowid")]

    def act(self, record_id: str, actor_id: str, action: str, expected_version: int, operation_id: str) -> dict[str, Any]:
        """Same order as the kernel: record, action, actor, authority, replay, version, state, then effects."""
        return self._write(lambda: self._act(record_id, actor_id, action, expected_version, operation_id))

    def _act(self, record_id, actor_id, action, expected_version, operation_id):
        record = self._record(record_id)
        step = transition(action)
        check_actor(actor(actor_id), step)
        binding = sha256(_canonical({"record": record_id, "actor": actor_id, "action": action,
                                     "expected_version": expected_version, "model": spec.MODEL_HASH}).encode()).hexdigest()
        prior = self.db.execute("SELECT binding, result FROM operations WHERE id=?", (operation_id,)).fetchone()
        if prior is not None:
            if prior["binding"] != binding:
                raise Refused("OPERATION_CONFLICT", "Operation id is already bound to another request")
            return {"duplicate": True, "committed": False, "record": record, "original_result": json.loads(prior["result"])}
        if record["version"] != expected_version:
            raise Refused("STALE_VERSION", "The record changed; reload before acting")
        if record["state"] != step["from"]:
            raise Refused("STATE_DENIED", f"{action} is only possible from {step['from']}")
        changed = self.db.execute("UPDATE records SET state=?, version=? WHERE id=? AND version=?",
                                  (step["to"], expected_version + 1, record_id, expected_version)).rowcount
        if changed != 1:
            raise Refused("STALE_VERSION", "Concurrent update")
        for effect in step["effects"]:
            self._perform(effect, record_id, actor_id, action, step, operation_id)
        result = {"duplicate": False, "committed": True, "record": self._record(record_id), "effects": list(step["effects"])}
        self.db.execute("INSERT INTO operations VALUES(?,?,?)", (operation_id, binding, _canonical(result)))
        return result

    def _perform(self, effect, record_id, actor_id, action, step, operation_id):
        declared = spec.EFFECTS.get(effect)
        if declared is None:
            raise Refused("EFFECT_DENIED", "No adapter exists for this effect")
        if declared["kind"] == "audit":
            self.db.execute("INSERT INTO audit(record_id,effect,actor,action,from_state,to_state) VALUES(?,?,?,?,?,?)",
                            (record_id, effect, actor_id, action, step["from"], step["to"]))
        else:
            self.db.execute("INSERT INTO outbox VALUES(?,?,?,?)",
                            (operation_id + ":" + effect, record_id, effect, declared["recipient"]))
