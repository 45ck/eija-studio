"""Generated by EIJA Studio. Storage for the app; every rule is decided by the EIJA kernel itself.

There is no second interpreter here: `act` calls `eija_studio.application.runtime.execute` and `create` calls
`runtime.initialise`, through a SQLite unit of work. The model and pack the app was built from are app/model.json and
app/pack.json. Do not edit: change the model in EIJA Studio and run `eija build` again.
"""
from __future__ import annotations

import json
import sqlite3
import threading
import time
from pathlib import Path
from typing import Any
from uuid import uuid4

from eija_studio.application.runtime import (check_actor, check_due, check_guards, check_linked, check_separation, execute, initialise,
                                             receive, separations)
from eija_studio.domain.data import DataModel, check_record, check_values, references
from eija_studio.domain.models import DomainError, ExecuteCommand, Workflow, canonical
from eija_studio.domain.pack import parse_pack
from eija_studio.domain.screens import Screens

HERE = Path(__file__).resolve().parent
PACK = parse_pack(json.loads((HERE / "pack.json").read_text(encoding="utf-8")))
MODEL = Workflow.model_validate_json((HERE / "model.json").read_text(encoding="utf-8"))
CASE = "app"  # the kernel scopes instances and operation bindings to a case; the app is one case
ACTORS = {a.id: a.model_dump() for a in PACK.fixtures.actors}
DATA = DataModel.model_validate_json((HERE / "data.json").read_text(encoding="utf-8")) if (HERE / "data.json").exists() else None
RECORD = DATA.entity(DATA.record) if DATA else None  # the class whose instances move through the workflow
DATA_DIGEST = DATA.digest if DATA else ""  # each record keeps the digest of the data model that checked its values
REFERENCES = references(DATA)  # built associations: record fields holding the id of a stored object (ADR-0235)
STORED = sorted({r.target for r in REFERENCES})  # the classes whose objects this app stores
SCREENS = Screens.model_validate_json((HERE / "screens.json").read_text(encoding="utf-8"))  # how the page looks, not rules

SCHEMA = """
CREATE TABLE IF NOT EXISTS records(id TEXT PRIMARY KEY, case_id TEXT NOT NULL, model_hash TEXT NOT NULL,
    state TEXT NOT NULL, version INTEGER NOT NULL, title TEXT NOT NULL DEFAULT '', created_by TEXT NOT NULL DEFAULT '',
    fields TEXT NOT NULL DEFAULT '{}', data_digest TEXT NOT NULL DEFAULT '', entered_at REAL);
CREATE TABLE IF NOT EXISTS operations(id TEXT PRIMARY KEY, binding TEXT NOT NULL, result TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS audit(seq INTEGER PRIMARY KEY AUTOINCREMENT, kind TEXT NOT NULL, body TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS outbox(id TEXT PRIMARY KEY, record_id TEXT NOT NULL, effect TEXT NOT NULL, recipient TEXT NOT NULL);
CREATE TABLE IF NOT EXISTS objects(id TEXT PRIMARY KEY, class TEXT NOT NULL, fields TEXT NOT NULL, created_by TEXT NOT NULL,
    state TEXT);
CREATE TABLE IF NOT EXISTS acts(seq INTEGER PRIMARY KEY AUTOINCREMENT, record_id TEXT NOT NULL, action TEXT NOT NULL, actor_id TEXT NOT NULL);
"""

MIGRATIONS = {"fields": "ALTER TABLE records ADD COLUMN fields TEXT NOT NULL DEFAULT '{}'",
              "data_digest": "ALTER TABLE records ADD COLUMN data_digest TEXT NOT NULL DEFAULT ''",
              "entered_at": "ALTER TABLE records ADD COLUMN entered_at REAL"}  # NULL: a time event is never due on it
OBJECT_MIGRATIONS = {"state": "ALTER TABLE objects ADD COLUMN state TEXT"}  # NULL: a step never moves such an object
LIFECYCLES = {o.entity: o for o in reversed(MODEL.objects)}  # each linked class's lifecycle (ADR-0241)

now = time.time  # the app's clock, which the kernel reads only through `Session.elapsed` (ADR-0237)

Refused = DomainError  # what the kernel raises; `code` is its stable refusal code


class Session:
    """The kernel's unit-of-work port, over this app's tables. The enclosing transaction commits or rolls back."""

    def __init__(self, db: sqlite3.Connection):
        self.db = db

    def actor(self, actor_id: str) -> dict[str, Any]:
        if actor_id not in ACTORS:
            raise DomainError("UNKNOWN_ACTOR", "Actor is not in the directory")
        return ACTORS[actor_id]

    def create_instance(self, item: dict[str, Any]) -> None:
        self.db.execute("INSERT INTO records(id,case_id,model_hash,state,version,entered_at) "
                        "VALUES(:id,:case_id,:model_hash,:state,:version,:entered_at)", item | {"entered_at": now()})

    def find_instance(self, instance_id: str, case_id: str) -> dict[str, Any] | None:
        row = self.db.execute("SELECT id,case_id,model_hash,state,version FROM records WHERE id=? AND case_id=?",
                              (instance_id, case_id)).fetchone()
        return dict(row) if row else None

    def update_instance(self, item: dict[str, Any], expected: int) -> None:
        changed = self.db.execute("UPDATE records SET state=?, version=?, entered_at=? WHERE id=? AND version=?",
                                  (item["state"], item["version"], now(), item["id"], expected)).rowcount
        if changed != 1:
            raise DomainError("STALE_VERSION", "Concurrent state update")

    def acts(self, instance_id: str) -> list[tuple[str, str]]:
        """Who took which action on a record, for the model's separation-of-duties laws; the kernel reads and writes it."""
        return [(r["action"], r["actor_id"]) for r in
                self.db.execute("SELECT action, actor_id FROM acts WHERE record_id=? ORDER BY seq", (instance_id,))]

    def record_act(self, instance_id: str, action: str, actor_id: str) -> None:
        self.db.execute("INSERT INTO acts(record_id, action, actor_id) VALUES(?,?,?)", (instance_id, action, actor_id))

    def values(self, instance_id: str) -> dict[str, Any]:
        """The record's checked values, which the model's guards over record values read (ADR-0234)."""
        row = self.db.execute("SELECT fields FROM records WHERE id=?", (instance_id,)).fetchone()
        return json.loads(row["fields"]) if row else {}

    def elapsed(self, instance_id: str) -> float | None:
        """Seconds since the record entered its state, which the model's time events read (ADR-0237). Every committed
        step enters its target state afresh. None for a record from a build that kept no entry time."""
        row = self.db.execute("SELECT entered_at FROM records WHERE id=?", (instance_id,)).fetchone()
        return None if row is None or row["entered_at"] is None else now() - row["entered_at"]

    def object_state(self, instance_id: str, link: str) -> str | None:
        """The state of the object the record's `link` field names, which the model's steps on linked objects read
        (ADR-0241). None when the record names no object, the object is unknown, or it has no state."""
        object_id = self.values(instance_id).get(link)
        row = self.db.execute("SELECT state FROM objects WHERE id=?", (object_id,)).fetchone() if object_id else None
        return None if row is None else row["state"]

    def move_object(self, instance_id: str, link: str, state: str) -> None:
        self.db.execute("UPDATE objects SET state=? WHERE id=?", (state, self.values(instance_id)[link]))

    def find_operation(self, operation_id: str) -> dict[str, Any] | None:
        row = self.db.execute("SELECT binding, result FROM operations WHERE id=?", (operation_id,)).fetchone()
        return {"binding": row["binding"], "result": json.loads(row["result"])} if row else None

    def record_operation(self, operation_id: str, binding: str, result: dict[str, Any]) -> None:
        self.db.execute("INSERT INTO operations VALUES(?,?,?)", (operation_id, binding, canonical(result)))

    def event(self, kind: str, body: dict[str, Any]) -> None:
        self.db.execute("INSERT INTO audit(kind, body) VALUES(?,?)", (kind, canonical(body)))

    def enqueue(self, case_id: str, operation_id: str, effect: str, recipient: str) -> None:
        self.db.execute("INSERT INTO outbox VALUES(?,?,?,?)", (operation_id + ":" + effect, case_id, effect, recipient))


def options(state: str, actor_id: str, acts: list[tuple[str, str]] | None = None,
            values: dict[str, Any] | None = None, elapsed: float | None = None,
            objects: dict[str, str | None] | None = None) -> list[dict[str, Any]]:
    """The actions leaving `state`, each with whether this actor may take it, using the kernel's own authority,
    time-event, value-guard, linked-object and separation-of-duties checks (`acts` is the record's history of who took
    which action, `elapsed` how long it has been in `state`, `objects` its linked objects' states)."""
    result = []
    for t in MODEL.transitions:
        if t.from_state != state:
            continue
        entry = {"action": t.action, "to": t.to_state, "role": t.role, "allowed": True,
                 **({"when": [str(c) for c in t.conditions]} if t.conditions else {}),
                 **({"after": str(t.after)} if t.after is not None else {}),
                 **({"then": [str(x) for x in t.then]} if t.then else {})}
        try:
            if actor_id not in ACTORS:
                raise DomainError("UNKNOWN_ACTOR", "Actor is not in the directory")
            check_actor(ACTORS[actor_id], t, None)  # type: ignore[arg-type]  # the command is not read by the check
            check_due(t, elapsed)
            check_guards(t, values or {})
            check_linked(MODEL, t, objects or {})
            check_separation(separations(PACK, MODEL, t.action), t.action, actor_id, acts or [])
        except DomainError as refused:
            entry |= {"allowed": False, "code": refused.code, "reason": refused.message}
        result.append(entry)
    return result


class Service:
    """All writes for one request commit together or not at all."""

    def __init__(self, path: str = ":memory:"):
        self.db = sqlite3.connect(path, check_same_thread=False, isolation_level=None)
        self.db.row_factory = sqlite3.Row
        self.lock = threading.Lock()
        self.db.executescript(SCHEMA)
        columns = {row["name"] for row in self.db.execute("PRAGMA table_info(records)")}
        for column, statement in MIGRATIONS.items():  # data from an older build; its records stay stale
            if column not in columns:
                self.db.execute(statement)
        if "state" not in {row["name"] for row in self.db.execute("PRAGMA table_info(objects)")}:
            self.db.execute(OBJECT_MIGRATIONS["state"])

    def _write(self, work):
        with self.lock:
            self.db.execute("BEGIN IMMEDIATE")
            try:
                result = work(Session(self.db))
            except BaseException:
                self.db.execute("ROLLBACK")
                raise
            self.db.execute("COMMIT")
            return result

    def _record(self, record_id: str) -> dict[str, Any]:
        row = self.db.execute("SELECT * FROM records WHERE id=?", (record_id,)).fetchone()
        if row is None:
            raise DomainError("NOT_FOUND", "No such record")
        record = dict(row)
        record["fields"] = json.loads(record["fields"])
        record["current_model"] = record["model_hash"] == MODEL.semantic_hash and record["data_digest"] == DATA_DIGEST
        return record

    def create(self, title: str, actor_id: str, fields: dict[str, Any] | None = None) -> dict[str, Any]:
        title = title.strip()
        if not 1 <= len(title) <= 200:
            raise DomainError("INVALID_TITLE", "Give a title of 1 to 200 characters")
        actor = self._active(actor_id)
        if DATA is not None:
            values = check_record(DATA, fields or {}, self._exists)  # the data model's own check, from eija_studio
        elif fields:
            raise DomainError("UNKNOWN_FIELD", "This app's model has no record attributes")
        else:
            values = {}

        def work(session: Session) -> dict[str, Any]:
            item = initialise(session, CASE, MODEL, pack=PACK, role=actor["role"])  # the model may name who starts a record
            self.db.execute("UPDATE records SET title=?, created_by=?, fields=?, data_digest=? WHERE id=?",
                            (title, actor_id, canonical(values), DATA_DIGEST, item["id"]))
            return self._record(item["id"])
        return self._write(work)

    def _active(self, actor_id: str) -> dict[str, Any]:
        actor = Session(self.db).actor(actor_id)
        if not actor["active"]:
            raise DomainError("ACTOR_REVOKED", "Actor is not active")
        return actor

    def _exists(self, cls: str, object_id: str) -> bool:
        return self.db.execute("SELECT 1 FROM objects WHERE class=? AND id=?", (cls, object_id)).fetchone() is not None

    def create_object(self, cls: str, actor_id: str, fields: dict[str, Any] | None = None) -> dict[str, Any]:
        """Store an object of a class a record refers to, its values checked by the data model (ADR-0235)."""
        if cls not in STORED:
            raise DomainError("NOT_FOUND", "This app stores no objects of that class")
        self._active(actor_id)
        values = check_values(DATA.entity(cls), fields or {})  # type: ignore[union-attr]  # STORED is empty without data

        def work(session: Session) -> dict[str, Any]:
            object_id = uuid4().hex
            lifecycle = LIFECYCLES.get(cls)  # an object with a lifecycle starts in its initial state (ADR-0241)
            state = lifecycle.initial if lifecycle is not None else None
            self.db.execute("INSERT INTO objects(id,class,fields,created_by,state) VALUES(?,?,?,?,?)",
                            (object_id, cls, canonical(values), actor_id, state))
            return {"id": object_id, "class": cls, "fields": values} | ({"state": state} if state else {})
        return self._write(work)

    def objects(self, cls: str) -> list[dict[str, Any]]:
        if cls not in STORED:
            raise DomainError("NOT_FOUND", "This app stores no objects of that class")
        return [{"id": r["id"], "class": cls, "fields": json.loads(r["fields"])} | ({"state": r["state"]} if r["state"] else {})
                for r in self.db.execute("SELECT id, fields, state FROM objects WHERE class=? ORDER BY rowid", (cls,))]

    def records(self) -> list[dict[str, Any]]:
        ids = [row[0] for row in self.db.execute("SELECT id FROM records ORDER BY rowid DESC")]
        return [self._record(record_id) for record_id in ids]

    def history(self, record_id: str) -> list[dict[str, Any]]:
        steps = []
        for row in self.db.execute("SELECT kind, body FROM audit ORDER BY seq"):
            body = json.loads(row["body"])
            if body.get("instance_id") == record_id:
                result = body.get("result", {})
                steps.append({"effect": row["kind"], "actor": body.get("actor_id"), "operation": body.get("operation_id"),
                              "state": result.get("instance", {}).get("state")})
        return steps

    def view(self, record_id: str, actor_id: str) -> dict[str, Any]:
        record, session = self._record(record_id), Session(self.db)
        objects = {o.link: session.object_state(record_id, o.link) for o in MODEL.objects}
        return {"record": record, "history": self.history(record_id),
                "options": options(record["state"], actor_id, session.acts(record_id), record["fields"],
                                   session.elapsed(record_id), objects)}

    def receive(self, signal: str, sender: str, operation_id: str, fields: dict[str, Any] | None = None) -> dict[str, Any]:
        """Start a record because another workflow of the system sent `signal` (ADR-0242). The signal carries the new
        record's values, which this app's data model checks as it checks a record a person creates. Delivering the same
        signal again under its operation id starts nothing new."""
        values = check_record(DATA, fields or {}, self._exists) if DATA is not None else {}
        if DATA is None and fields:
            raise DomainError("UNKNOWN_FIELD", "This app's model has no record attributes")

        def work(session: Session) -> dict[str, Any]:
            result = receive(session, CASE, MODEL, signal, sender, operation_id, pack=PACK, values=values)
            if result["duplicate"]:
                return {"duplicate": True, "started": False, "record": self._record(result["original_result"]["instance"]["id"])}
            record_id = result["instance"]["id"]
            self.db.execute("UPDATE records SET title=?, created_by=?, fields=?, data_digest=? WHERE id=?",
                            (f"{signal} from {sender}", sender, canonical(values), DATA_DIGEST, record_id))
            return {"duplicate": False, "started": True, "record": self._record(record_id)}
        return self._write(work)

    def outbox(self) -> list[dict[str, Any]]:
        return [dict(r) for r in self.db.execute("SELECT * FROM outbox ORDER BY rowid")]

    def act(self, record_id: str, actor_id: str, action: str, expected_version: int, operation_id: str) -> dict[str, Any]:
        command = ExecuteCommand(operation_id=operation_id, actor_id=actor_id, instance_id=record_id, action=action,
                                 expected_version=expected_version)
        row = self.db.execute("SELECT data_digest FROM records WHERE id=?", (record_id,)).fetchone()
        if row is not None and row["data_digest"] != DATA_DIGEST:  # values never checked by this data model
            raise DomainError("STALE_DATA", "This record was created under an earlier data model; actions on it are refused")

        def work(session: Session) -> dict[str, Any]:
            result = execute(session, CASE, MODEL, command, pack=PACK)
            return {"duplicate": result["duplicate"], "committed": result["committed"],
                    "record": self._record(record_id), "effects": result["effects"]}
        return self._write(work)
