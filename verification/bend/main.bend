def Actor.role(a: Actor) -> Role:
  Actor{role, active, assigned} = a
  role

def live(a: Actor) -> Bool:
  Actor{role, active, assigned} = a
  active

def role_is(r: Maybe<&2, Rule>, +role: Role) -> Bool:
  match r:
    case None{}:
      False{}
    case Some{rule}:
      Rule{from, to, rrole, needs, effects} = rule
      Role.eq(role, rrole)

