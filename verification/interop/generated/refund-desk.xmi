            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-DECLINE.effect">
              <language>PlayIDE</language>
              <body>Audit:RefundDeclined, Notification:CustomerToldDeclined</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-DISMISS" name="TR-DISMISS" source="state.WithSupervisor" target="state.Declined">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-DISMISS.trigger" name="DismissEscalation" event="event.DismissEscalation" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-DISMISS.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-DISMISS.guard.spec">
