            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-DISMISS.effect">
              <language>PlayIDE</language>
              <body>Audit:EscalationDismissed, Notification:CustomerToldDeclined</body>
            </effect>
