          <transition xmi:type="uml:Transition" xmi:id="transition.TR-ESCALATE" name="TR-ESCALATE" source="state.AwaitingApproval" target="state.WithSupervisor">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-ESCALATE.trigger" name="EscalateStale" event="event.EscalateStale" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-ESCALATE.guard">
