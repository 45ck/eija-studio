            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-RESOLVE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-RESOLVE.guard.spec">
                <language>PlayIDE</language>
                <body>role = Supervisor and assigned</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-RESOLVE.effect">
              <language>PlayIDE</language>
              <body>Audit:EscalationResolved</body>
