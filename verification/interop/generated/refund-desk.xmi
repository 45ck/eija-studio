          <transition xmi:type="uml:Transition" xmi:id="transition.TR-APPROVE" name="TR-APPROVE" source="state.AwaitingApproval" target="state.Approved">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-APPROVE.trigger" name="ApproveRefund" event="event.ApproveRefund" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-APPROVE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-APPROVE.guard.spec">
