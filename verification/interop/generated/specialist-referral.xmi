<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
  <uml:Model xmi:id="model.specialist-referral" name="Specialist referral">
    <ownedComment xmi:type="uml:Comment" xmi:id="model.specialist-referral.comment">
      <body>Healthcare: a GP refers a patient to a specialist clinic. A triage nurse on the clinic's rota triages it, a scheduler books it, the specialist sees the patient and discharges them back to the GP with a letter. Three ways to end besides discharge: declined, withdrawn by the patient, or rebooked after a missed appointment.</body>
    </ownedComment>
    <packagedElement xmi:type="uml:DataType" xmi:id="type.Date" name="Date" />
    <packagedElement xmi:type="uml:Class" xmi:id="class.Referral" name="Referral" classifierBehavior="sm.specialist-referral">
      <ownedComment xmi:type="uml:Comment" xmi:id="class.Referral.comment">
        <body>One GP's request for one patient to be seen by one clinic.</body>
      </ownedComment>
      <ownedAttribute xmi:type="uml:Property" xmi:id="class.Referral.patientNumber" name="patientNumber">
        <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="class.Referral.patientNumber.lower" value="1" />
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="class.Referral.patientNumber.upper" value="1" />
      </ownedAttribute>
      <ownedRule xmi:type="uml:Constraint" xmi:id="class.Referral.patientNumber.maxLength" name="patientNumber maxLength" constrainedElement="class.Referral.patientNumber">
        <specification xmi:type="uml:OpaqueExpression" xmi:id="class.Referral.patientNumber.maxLength.spec">
          <language>OCL</language>
          <body>patientNumber.size() &lt;= 10</body>
        </specification>
