      <ownedBehavior xmi:type="uml:StateMachine" xmi:id="sm.ai-ops" name="AI ops deploys">
        <region xmi:type="uml:Region" xmi:id="sm.ai-ops.region" name="main">
          <subvertex xmi:type="uml:Pseudostate" xmi:id="sm.ai-ops.initial" kind="initial" />
          <subvertex xmi:type="uml:State" xmi:id="state.Opened" name="Opened" />
          <subvertex xmi:type="uml:State" xmi:id="state.InBuild" name="InBuild" />
          <subvertex xmi:type="uml:State" xmi:id="state.BuildRed" name="BuildRed" />
          <subvertex xmi:type="uml:State" xmi:id="state.AwaitingSignoff" name="AwaitingSignoff" />
          <subvertex xmi:type="uml:State" xmi:id="state.Scheduled" name="Scheduled" />
          <subvertex xmi:type="uml:State" xmi:id="state.Rolling" name="Rolling" />
          <subvertex xmi:type="uml:State" xmi:id="state.InProduction" name="InProduction" />
          <subvertex xmi:type="uml:State" xmi:id="state.RolledBack" name="RolledBack" />
          <subvertex xmi:type="uml:State" xmi:id="state.Abandoned" name="Abandoned" />
          <transition xmi:type="uml:Transition" xmi:id="sm.ai-ops.start" source="sm.ai-ops.initial" target="state.Opened" />
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-ABANDON" name="TR-ABANDON" source="state.BuildRed" target="state.Abandoned">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-ABANDON.trigger" name="AbandonChange" event="event.AbandonChange" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-ABANDON.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-ABANDON.guard.spec">
                <language>PlayIDE</language>
                <body>role = OnCall</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-ABANDON.effect">
              <language>PlayIDE</language>
              <body>Audit:ChangeAbandoned</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-BUILD" name="TR-BUILD" source="state.Opened" target="state.InBuild">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-BUILD.trigger" name="StartBuild" event="event.StartBuild" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-BUILD.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-BUILD.guard.spec">
                <language>PlayIDE</language>
                <body>role = OpsAgent</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-BUILD.effect">
              <language>PlayIDE</language>
              <body>Audit:BuildRequested</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-GREEN" name="TR-GREEN" source="state.InBuild" target="state.AwaitingSignoff">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-GREEN.trigger" name="ReportGreen" event="event.ReportGreen" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-GREEN.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-GREEN.guard.spec">
                <language>PlayIDE</language>
                <body>role = CiServer</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-GREEN.effect">
              <language>PlayIDE</language>
              <body>Audit:BuildPassed, Notification:OnCallAsked</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-HEALTHY" name="TR-HEALTHY" source="state.Rolling" target="state.InProduction">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-HEALTHY.trigger" name="ConfirmHealthy" event="event.ConfirmHealthy" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-HEALTHY.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-HEALTHY.guard.spec">
                <language>PlayIDE</language>
                <body>role = HealthMonitor</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-HEALTHY.effect">
              <language>PlayIDE</language>
              <body>Audit:RolloutHealthy</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-PATCH" name="TR-PATCH" source="state.BuildRed" target="state.InBuild">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-PATCH.trigger" name="PatchAndRetry" event="event.PatchAndRetry" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-PATCH.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-PATCH.guard.spec">
                <language>PlayIDE</language>
                <body>role = OpsAgent</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-PATCH.effect">
              <language>PlayIDE</language>
              <body>Audit:PatchPushed</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-RED" name="TR-RED" source="state.InBuild" target="state.BuildRed">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-RED.trigger" name="ReportRed" event="event.ReportRed" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-RED.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-RED.guard.spec">
                <language>PlayIDE</language>
                <body>role = CiServer</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-RED.effect">
              <language>PlayIDE</language>
              <body>Audit:BuildFailed</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-ROLLBACK" name="TR-ROLLBACK" source="state.Rolling" target="state.RolledBack">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-ROLLBACK.trigger" name="AutoRollback" event="event.AutoRollback" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-ROLLBACK.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-ROLLBACK.guard.spec">
                <language>PlayIDE</language>
                <body>role = HealthMonitor</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-ROLLBACK.effect">
              <language>PlayIDE</language>
              <body>Audit:RolloutReverted, Notification:OnCallPaged</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-SIGNOFF" name="TR-SIGNOFF" source="state.AwaitingSignoff" target="state.Scheduled">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-SIGNOFF.trigger" name="SignOffDeploy" event="event.SignOffDeploy" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-SIGNOFF.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-SIGNOFF.guard.spec">
                <language>PlayIDE</language>
                <body>role = OnCall and assigned</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-SIGNOFF.effect">
              <language>PlayIDE</language>
              <body>Audit:DeploySignedOff</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-TURNDOWN" name="TR-TURNDOWN" source="state.AwaitingSignoff" target="state.Abandoned">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-TURNDOWN.trigger" name="TurnDown" event="event.TurnDown" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-TURNDOWN.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-TURNDOWN.guard.spec">
                <language>PlayIDE</language>
                <body>role = OnCall</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-TURNDOWN.effect">
              <language>PlayIDE</language>
              <body>Audit:DeployTurnedDown</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-WINDOW" name="TR-WINDOW" source="state.Scheduled" target="state.Rolling">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-WINDOW.trigger" name="OpenWindow" event="event.OpenWindow" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-WINDOW.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-WINDOW.guard.spec">
                <language>PlayIDE</language>
                <body>role = DeployWindow</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-WINDOW.effect">
              <language>PlayIDE</language>
              <body>Audit:RolloutStarted, Notification:TeamTold</body>
            </effect>
          </transition>
        </region>
      </ownedBehavior>
