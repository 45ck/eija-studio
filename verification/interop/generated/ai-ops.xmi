    <packagedElement xmi:type="uml:Actor" xmi:id="actor.OpsAgent" name="OpsAgent">
      <ownedComment xmi:type="uml:Comment" xmi:id="actor.OpsAgent.comment">
        <body>An AI ops agent: opens a change, asks for a build, patches a red build. It never signs a deploy off.</body>
      </ownedComment>
    </packagedElement>
