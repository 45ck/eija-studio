            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-CLEAR.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-CLEAR.guard.spec">
                <language>PlayIDE</language>
                <body>role = CustomsOfficer</body>
              </specification>
