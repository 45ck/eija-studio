          <transition xmi:type="uml:Transition" xmi:id="transition.TR-REATTEMPT" name="TR-REATTEMPT" source="state.AttemptFailed" target="state.AtHub">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-REATTEMPT.trigger" name="ScheduleReattempt" event="event.ScheduleReattempt" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-REATTEMPT.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-REATTEMPT.guard.spec">
                <language>PlayIDE</language>
                <body>role = HubOperator</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-REATTEMPT.effect">
              <language>PlayIDE</language>
              <body>Audit:ReattemptScheduled</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-RETURN" name="TR-RETURN" source="state.AttemptFailed" target="state.ReturnedToSender">
