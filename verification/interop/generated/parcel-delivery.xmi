            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-COLLECT.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-COLLECT.guard.spec">
                <language>PlayIDE</language>
                <body>role = Driver and assigned</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-COLLECT.effect">
