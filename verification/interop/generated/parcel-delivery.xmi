          <transition xmi:type="uml:Transition" xmi:id="transition.TR-MISS" name="TR-MISS" source="state.OutForDelivery" target="state.AttemptFailed">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-MISS.trigger" name="RecordMissedDelivery" event="event.RecordMissedDelivery" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-MISS.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-MISS.guard.spec">
                <language>PlayIDE</language>
                <body>role = Driver and assigned</body>
              </specification>
