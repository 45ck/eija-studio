          <transition xmi:type="uml:Transition" xmi:id="transition.TR-DELIVER" name="TR-DELIVER" source="state.OutForDelivery" target="state.Delivered">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-DELIVER.trigger" name="Deliver" event="event.Deliver" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-DELIVER.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-DELIVER.guard.spec">
                <language>PlayIDE</language>
