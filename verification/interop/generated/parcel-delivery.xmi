          <transition xmi:type="uml:Transition" xmi:id="sm.parcel-delivery.start" source="sm.parcel-delivery.initial" target="state.Booked" />
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-CANCEL" name="TR-CANCEL" source="state.Booked" target="state.Cancelled">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-CANCEL.trigger" name="CancelBooking" event="event.CancelBooking" />
