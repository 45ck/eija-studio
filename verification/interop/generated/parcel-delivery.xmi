          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-LOAD" name="TR-LOAD" source="state.AtHub" target="state.OutForDelivery">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-LOAD.trigger" name="LoadVan" event="event.LoadVan" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-LOAD.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-LOAD.guard.spec">
                <language>PlayIDE</language>
                <body>role = Driver and assigned</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-LOAD.effect">
              <language>PlayIDE</language>
              <body>Audit:LoadedForDelivery, Notification:RecipientToldEta</body>
            </effect>
