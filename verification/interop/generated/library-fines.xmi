          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-WAIVE" name="TR-WAIVE" source="state.Issued" target="state.Waived">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-WAIVE.trigger" name="Waive" event="event.Waive" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-WAIVE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-WAIVE.guard.spec">
                <language>PlayIDE</language>
                <body>role = Librarian</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-WAIVE.effect">
              <language>PlayIDE</language>
              <body>Audit:FineWaived, Notification:MemberNotified</body>
            </effect>
          </transition>
        </region>
