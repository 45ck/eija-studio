                <body>role = Member</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-DISPUTE.effect">
              <language>PlayIDE</language>
              <body>Audit:FineDisputed</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-PAY" name="TR-PAY" source="state.Issued" target="state.Paid">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-PAY.trigger" name="Pay" event="event.Pay" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-PAY.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-PAY.guard.spec">
                <language>PlayIDE</language>
                <body>role = Member</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-PAY.effect">
              <language>PlayIDE</language>
              <body>Audit:FinePaid</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-UPHOLD" name="TR-UPHOLD" source="state.Disputed" target="state.Issued">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-UPHOLD.trigger" name="Uphold" event="event.Uphold" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-UPHOLD.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-UPHOLD.guard.spec">
                <language>PlayIDE</language>
                <body>role = Librarian</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-UPHOLD.effect">
              <language>PlayIDE</language>
              <body>Audit:FineUpheld, Notification:MemberNotified</body>
