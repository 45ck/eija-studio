        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="class.Fine.amount.lower" value="1" />
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="class.Fine.amount.upper" value="1" />
