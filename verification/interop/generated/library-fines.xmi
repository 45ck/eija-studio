      <ownedBehavior xmi:type="uml:StateMachine" xmi:id="sm.library-fines" name="Library fines">
        <region xmi:type="uml:Region" xmi:id="sm.library-fines.region" name="main">
          <subvertex xmi:type="uml:Pseudostate" xmi:id="sm.library-fines.initial" kind="initial" />
          <subvertex xmi:type="uml:State" xmi:id="state.Issued" name="Issued" />
          <subvertex xmi:type="uml:State" xmi:id="state.Paid" name="Paid" />
          <subvertex xmi:type="uml:State" xmi:id="state.Disputed" name="Disputed" />
          <subvertex xmi:type="uml:State" xmi:id="state.Waived" name="Waived" />
          <transition xmi:type="uml:Transition" xmi:id="sm.library-fines.start" source="sm.library-fines.initial" target="state.Issued" />
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-CONCEDE" name="TR-CONCEDE" source="state.Disputed" target="state.Waived">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-CONCEDE.trigger" name="Concede" event="event.Concede" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-CONCEDE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-CONCEDE.guard.spec">
                <language>PlayIDE</language>
                <body>role = Librarian</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-CONCEDE.effect">
              <language>PlayIDE</language>
              <body>Audit:DisputeConceded, Notification:MemberNotified</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-DISPUTE" name="TR-DISPUTE" source="state.Issued" target="state.Disputed">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-DISPUTE.trigger" name="Dispute" event="event.Dispute" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-DISPUTE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-DISPUTE.guard.spec">
