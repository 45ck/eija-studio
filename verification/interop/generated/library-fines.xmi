      </ownedAttribute>
      <ownedAttribute xmi:type="uml:Property" xmi:id="class.Fine.note" name="note">
        <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
        <lowerValue xmi:type="uml:LiteralInteger" xmi:id="class.Fine.note.lower" value="0" />
        <upperValue xmi:type="uml:LiteralUnlimitedNatural" xmi:id="class.Fine.note.upper" value="1" />
