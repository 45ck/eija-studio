  <uml:Model xmi:id="model.library-loan" name="Library loan">
    <ownedComment xmi:type="uml:Comment" xmi:id="model.library-loan.comment">
      <body>A second, structurally different pack: a loan is requested, checked out, may go overdue, and ends returned or cancelled. It has two final states, three roles and a sequence law (no return without a loan) that the excursion pack lacks.</body>
    </ownedComment>
    <packagedElement xmi:type="uml:DataType" xmi:id="type.Date" name="Date" />
