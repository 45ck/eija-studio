      <ownedBehavior xmi:type="uml:StateMachine" xmi:id="sm.library-loan" name="Library loan">
        <region xmi:type="uml:Region" xmi:id="sm.library-loan.region" name="main">
          <subvertex xmi:type="uml:Pseudostate" xmi:id="sm.library-loan.initial" kind="initial" />
          <subvertex xmi:type="uml:State" xmi:id="state.Requested" name="Requested" />
          <subvertex xmi:type="uml:State" xmi:id="state.OnLoan" name="OnLoan" />
          <subvertex xmi:type="uml:State" xmi:id="state.Overdue" name="Overdue" />
          <subvertex xmi:type="uml:State" xmi:id="state.Returned" name="Returned" />
          <subvertex xmi:type="uml:State" xmi:id="state.Cancelled" name="Cancelled" />
          <transition xmi:type="uml:Transition" xmi:id="sm.library-loan.start" source="sm.library-loan.initial" target="state.Requested" />
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-CANCEL" name="TR-CANCEL" source="state.Requested" target="state.Cancelled">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-CANCEL.trigger" name="Cancel" event="event.Cancel" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-CANCEL.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-CANCEL.guard.spec">
                <language>PlayIDE</language>
                <body>role = Member</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-CANCEL.effect">
              <language>PlayIDE</language>
              <body>Audit:LoanCancelled</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-CHECKOUT" name="TR-CHECKOUT" source="state.Requested" target="state.OnLoan">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-CHECKOUT.trigger" name="CheckOut" event="event.CheckOut" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-CHECKOUT.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-CHECKOUT.guard.spec">
                <language>PlayIDE</language>
                <body>role = Librarian and assigned</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-CHECKOUT.effect">
              <language>PlayIDE</language>
              <body>Audit:LoanCheckedOut, Notification:MemberNotified</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-MARKOVERDUE" name="TR-MARKOVERDUE" source="state.OnLoan" target="state.Overdue">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-MARKOVERDUE.trigger" name="MarkOverdue" event="event.MarkOverdue" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-MARKOVERDUE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-MARKOVERDUE.guard.spec">
                <language>PlayIDE</language>
                <body>role = Clerk</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-MARKOVERDUE.effect">
              <language>PlayIDE</language>
              <body>Audit:LoanOverdue, Notification:OverdueNoticeQueued</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-RETURN" name="TR-RETURN" source="state.OnLoan" target="state.Returned">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-RETURN.trigger" name="Return" event="event.Return" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-RETURN.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-RETURN.guard.spec">
                <language>PlayIDE</language>
                <body>role = Librarian</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-RETURN.effect">
              <language>PlayIDE</language>
              <body>Audit:LoanReturned</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-RETURNLATE" name="TR-RETURNLATE" source="state.Overdue" target="state.Returned">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-RETURNLATE.trigger" name="ReturnLate" event="event.ReturnLate" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-RETURNLATE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-RETURNLATE.guard.spec">
                <language>PlayIDE</language>
                <body>role = Librarian</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-RETURNLATE.effect">
              <language>PlayIDE</language>
              <body>Audit:LoanReturnedLate</body>
            </effect>
          </transition>
        </region>
