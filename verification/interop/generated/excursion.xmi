            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-REVISE.effect">
              <language>PlayIDE</language>
              <body>Audit:ExcursionReopened</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-SUBMIT" name="TR-SUBMIT" source="state.Draft" target="state.Submitted">
