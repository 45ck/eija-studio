<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
  <uml:Model xmi:id="model.card-payment" name="Card payment and refund">
    <ownedComment xmi:type="uml:Comment" xmi:id="model.card-payment.comment">
      <body>Payments: a card payment is authorised and captured by the payment gateway, can be voided before capture, refunded on a finance approval, or disputed by the cardholder's bank. Four final states, a system actor (the gateway), and refund authority kept away from support.</body>
    </ownedComment>
    <packagedElement xmi:type="uml:DataType" xmi:id="type.Date" name="Date" />
