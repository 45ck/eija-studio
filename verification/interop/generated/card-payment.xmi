      <ownedComment xmi:type="uml:Comment" xmi:id="class.Payment.comment">
        <body>One card payment for one order. It keeps only the last four card digits, never the card number.</body>
      </ownedComment>
      <ownedAttribute xmi:type="uml:Property" xmi:id="class.Payment.orderNumber" name="orderNumber">
        <type xmi:type="uml:PrimitiveType" href="http://www.omg.org/spec/UML/20161101/PrimitiveTypes.xmi#String" />
