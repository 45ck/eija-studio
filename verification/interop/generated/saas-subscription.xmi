            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-SUSPEND.effect">
              <language>PlayIDE</language>
              <body>Audit:WorkspaceSuspended, Notification:SuspensionNotice</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-VERIFY" name="TR-VERIFY" source="state.SignedUp" target="state.Trialing">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-VERIFY.trigger" name="VerifyEmail" event="event.VerifyEmail" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-VERIFY.guard">
