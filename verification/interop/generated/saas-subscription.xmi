<xmi:XMI xmlns:uml="http://www.omg.org/spec/UML/20161101" xmlns:xmi="http://www.omg.org/spec/XMI/20131001">
  <uml:Model xmi:id="model.saas-subscription" name="SaaS workspace subscription">
    <ownedComment xmi:type="uml:Comment" xmi:id="model.saas-subscription.comment">
      <body>SaaS: a workspace is signed up, verified into a trial, subscribed, and then lives through failed payments (past due, suspended), reactivation by customer success, cancellation by its owner or a trust-and-safety freeze. The billing system is an actor; suspension stays automated.</body>
    </ownedComment>
    <packagedElement xmi:type="uml:DataType" xmi:id="type.Date" name="Date" />
