            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-SUBSCRIBE.effect">
              <language>PlayIDE</language>
              <body>Audit:SubscriptionStarted, Notification:FirstInvoiceSent</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-SUSPEND" name="TR-SUSPEND" source="state.PastDue" target="state.Suspended">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-SUSPEND.trigger" name="Suspend" event="event.Suspend" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-SUSPEND.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-SUSPEND.guard.spec">
                <language>PlayIDE</language>
                <body>role = BillingSystem</body>
              </specification>
