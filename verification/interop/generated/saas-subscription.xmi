      <ownedBehavior xmi:type="uml:StateMachine" xmi:id="sm.saas-subscription" name="SaaS workspace subscription">
        <region xmi:type="uml:Region" xmi:id="sm.saas-subscription.region" name="main">
          <subvertex xmi:type="uml:Pseudostate" xmi:id="sm.saas-subscription.initial" kind="initial" />
          <subvertex xmi:type="uml:State" xmi:id="state.SignedUp" name="SignedUp" />
          <subvertex xmi:type="uml:State" xmi:id="state.Trialing" name="Trialing" />
          <subvertex xmi:type="uml:State" xmi:id="state.Paying" name="Paying" />
          <subvertex xmi:type="uml:State" xmi:id="state.PastDue" name="PastDue" />
          <subvertex xmi:type="uml:State" xmi:id="state.Suspended" name="Suspended" />
          <subvertex xmi:type="uml:State" xmi:id="state.Cancelled" name="Cancelled" />
          <subvertex xmi:type="uml:State" xmi:id="state.FrozenForAbuse" name="FrozenForAbuse" />
          <transition xmi:type="uml:Transition" xmi:id="sm.saas-subscription.start" source="sm.saas-subscription.initial" target="state.SignedUp" />
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-CANCEL" name="TR-CANCEL" source="state.Paying" target="state.Cancelled">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-CANCEL.trigger" name="CancelSubscription" event="event.CancelSubscription" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-CANCEL.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-CANCEL.guard.spec">
                <language>PlayIDE</language>
                <body>role = WorkspaceOwner and assigned</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-CANCEL.effect">
              <language>PlayIDE</language>
              <body>Audit:SubscriptionCancelled, Notification:DataExportOffered</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-ENDTRIAL" name="TR-ENDTRIAL" source="state.Trialing" target="state.Cancelled">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-ENDTRIAL.trigger" name="EndTrial" event="event.EndTrial" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-ENDTRIAL.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-ENDTRIAL.guard.spec">
                <language>PlayIDE</language>
                <body>role = BillingSystem</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-ENDTRIAL.effect">
              <language>PlayIDE</language>
              <body>Audit:TrialEnded, Notification:TrialEndedEmail</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-FREEZE" name="TR-FREEZE" source="state.Paying" target="state.FrozenForAbuse">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-FREEZE.trigger" name="FreezeForAbuse" event="event.FreezeForAbuse" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-FREEZE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-FREEZE.guard.spec">
                <language>PlayIDE</language>
                <body>role = TrustAndSafety</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-FREEZE.effect">
              <language>PlayIDE</language>
              <body>Audit:AbuseFreeze</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-MISSPAYMENT" name="TR-MISSPAYMENT" source="state.Paying" target="state.PastDue">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-MISSPAYMENT.trigger" name="MissPayment" event="event.MissPayment" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-MISSPAYMENT.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-MISSPAYMENT.guard.spec">
                <language>PlayIDE</language>
                <body>role = BillingSystem</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-MISSPAYMENT.effect">
              <language>PlayIDE</language>
              <body>Audit:PaymentFailed, Notification:DunningEmail</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-PAYOVERDUE" name="TR-PAYOVERDUE" source="state.PastDue" target="state.Paying">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-PAYOVERDUE.trigger" name="PayOverdue" event="event.PayOverdue" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-PAYOVERDUE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-PAYOVERDUE.guard.spec">
                <language>PlayIDE</language>
                <body>role = WorkspaceOwner and assigned</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-PAYOVERDUE.effect">
              <language>PlayIDE</language>
              <body>Audit:PaymentRecovered</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-REACTIVATE" name="TR-REACTIVATE" source="state.Suspended" target="state.Paying">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-REACTIVATE.trigger" name="Reactivate" event="event.Reactivate" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-REACTIVATE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-REACTIVATE.guard.spec">
                <language>PlayIDE</language>
                <body>role = SuccessManager and assigned</body>
              </specification>
            </guard>
            <effect xmi:type="uml:OpaqueBehavior" xmi:id="transition.TR-REACTIVATE.effect">
              <language>PlayIDE</language>
              <body>Audit:WorkspaceReactivated, Notification:ReactivatedEmail</body>
            </effect>
          </transition>
          <transition xmi:type="uml:Transition" xmi:id="transition.TR-SUBSCRIBE" name="TR-SUBSCRIBE" source="state.Trialing" target="state.Paying">
            <trigger xmi:type="uml:Trigger" xmi:id="transition.TR-SUBSCRIBE.trigger" name="Subscribe" event="event.Subscribe" />
            <guard xmi:type="uml:Constraint" xmi:id="transition.TR-SUBSCRIBE.guard">
              <specification xmi:type="uml:OpaqueExpression" xmi:id="transition.TR-SUBSCRIBE.guard.spec">
                <language>PlayIDE</language>
                <body>role = WorkspaceOwner and assigned</body>
