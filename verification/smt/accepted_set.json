      "Registrar",
      "Viewer",
      "<other>"
    ],
    "states": [
      "Draft",
      "Submitted",
      "Recommended",
      "Approved",
      "Rejected",
      "<other>"
    ],
    "unknown_action_slot": true,
    "unknown_state_slot": true
  },
  "invariants": [
    {
      "id": "INV-TEACHER-NOT-DECIDER",
      "statement": "Teacher never holds Approve or Reject."
    },
    {
      "id": "INV-REGISTRAR-ONLY-DECIDES",
      "statement": "Approve and Reject are held by Registrar and by no other role."
    },
    {
      "id": "INV-TEACHER-TRANSITIONS-NEVER-DECIDE",
      "statement": "No Teacher-held transition (of any action) ends in Approved or Rejected."
    },
    {
      "id": "INV-TEACHER-EMITS-NO-DECISION-AUDIT",
      "statement": "No Teacher-held transition requires an Approved or Rejected audit effect."
    },
    {
      "id": "INV-APPROVE-REQUIRES-RECOMMENDED",
      "statement": "When the recommendation meaning is enabled (Recommend exists), Approve starts from Recommended."
    },
    {
      "id": "INV-APPROVED-ONLY-VIA-APPROVE",
      "statement": "Approve is the only transition that can end in Approved."
    },
    {
      "id": "INV-RECOMMEND-REQUIRES-ASSIGNMENT",
      "statement": "Recommend is guarded by actor_assigned and held by Teacher."
    },
    {
      "id": "INV-RECOMMEND-CANNOT-CONCLUDE",
      "statement": "Recommend ends in Recommended, never in Approved or Rejected."
    },
    {
      "id": "INV-REJECT-SOURCE-BOUNDED",
      "statement": "Reject starts only from Recommended or Submitted."
    },
    {
      "id": "INV-FORBIDDEN-EFFECTS-EXCLUDED",
      "statement": "No transition requires a forbidden effect, and every transition forbids all of them."
    },
    {
      "id": "INV-MANDATORY-GUARDS-PRESENT",
      "statement": "Every transition carries every base guard (a candidate cannot weaken authority checks)."
    },
    {
      "id": "INV-CLOSED-WORKFLOW",
      "statement": "The workflow starts in Draft, has no unknown action and no unknown state."
    }
  ],
