          "Audit:CompletionCertified",
          "Notification:CertificateSent"
        ],
        "forbidden_effects": [
          "DecisionWithoutReasons",
          "ApplicantDataPublished"
        ]
      }
    ]
  },
  "roles": [
    {
      "id": "Applicant",
      "description": "Lodges, answers requests for information, and may withdraw before acceptance."
    },
    {
      "id": "IntakeOfficer",
      "description": "Checks the lodgement is complete and issues approved permits."
    },
    {
      "id": "PlanReviewer",
      "description": "Reviews the plans against the code; must be allocated the application."
    },
    {
      "id": "PermitManager",
      "description": "The delegated decision maker for the area; approves, refuses and certifies."
    },
    {
      "id": "SiteInspector",
      "description": "Inspects the works on site; must be allocated the site."
    }
