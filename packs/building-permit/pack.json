{
  "schema_version": "eija.pack.v1",
  "pack": {
    "id": "building-permit",
    "name": "Building permit",
    "version": "1.0.0",
    "description": "Government: a building permit application is lodged, accepted by intake, reviewed by a plan reviewer (who may ask the applicant for more information), decided by the permit manager for the area, issued, inspected and certified complete. Decisions stay with the delegated manager and always follow a plan review."
  },
  "model": {
    "schema_version": "eija.workflow.v1",
    "id": "building-permit",
    "initial_state": "Lodged",
    "states": [
      "Lodged",
      "Registered",
      "InReview",
      "InfoRequested",
      "Approved",
      "PermitRefused",
      "Issued",
      "Inspected",
      "Completed",
      "Withdrawn"
    ],
    "transitions": [
      {
        "id": "TR-WITHDRAW",
        "action": "Withdraw",
        "from_state": "Lodged",
        "to_state": "Withdrawn",
        "role": "Applicant",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding",
          "actor_assigned"
        ],
        "required_effects": [
          "Audit:ApplicationWithdrawn"
        ],
        "forbidden_effects": [
          "DecisionWithoutReasons",
          "ApplicantDataPublished"
        ]
      },
      {
        "id": "TR-ACCEPT",
