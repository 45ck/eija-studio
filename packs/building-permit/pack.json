  "laws": [
    {
      "id": "approval-after-review",
      "kind": "path_requires",
      "code": "APPROVED_WITHOUT_REVIEW",
      "description": "Every path to Approved passes through InReview: no permit is approved without a plan review.",
      "state": "Approved",
      "via": "InReview"
    },
    {
      "id": "issued-after-approval",
      "kind": "path_requires",
      "code": "ISSUED_WITHOUT_APPROVAL",
      "description": "Every path to Issued passes through Approved.",
      "state": "Issued",
      "via": "Approved"
    },
    {
      "id": "completed-after-inspection",
      "kind": "path_requires",
      "code": "COMPLETED_WITHOUT_INSPECTION",
      "description": "No completion certificate without a passed inspection.",
      "state": "Completed",
      "via": "Inspected"
    },
    {
      "id": "manager-approves",
      "kind": "only_role_holds",
      "code": "PROTECTED_AUTHORITY:Approve",
      "description": "Only the delegated permit manager approves.",
      "action": "Approve",
      "role": "PermitManager"
    },
    {
      "id": "manager-refuses",
      "kind": "only_role_holds",
      "code": "PROTECTED_AUTHORITY:RefusePermit",
      "description": "Only the delegated permit manager refuses.",
      "action": "RefusePermit",
      "role": "PermitManager"
    },
    {
      "id": "reviewer-never-decides",
      "kind": "role_never_enters",
      "code": "PROTECTED_AUTHORITY:Approved",
      "description": "The plan reviewer recommends but never decides.",
      "role": "PlanReviewer",
      "state": "Approved"
    },
    {
      "id": "approve-needs-delegation",
      "kind": "action_requires_guard",
      "code": "GUARD_POLICY:Approve",
      "description": "A manager approves only applications in their delegated area.",
      "action": "Approve",
      "guards": [
        "actor_assigned"
      ]
    },
    {
      "id": "approved-only-via-approve",
      "kind": "state_only_via",
      "code": "PROTECTED_STATE:Approved",
      "description": "Only a manager's approval approves.",
      "state": "Approved",
      "actions": [
        "Approve"
      ]
    },
    {
      "id": "withdraw-before-acceptance",
      "kind": "action_source_in",
      "code": "PROTECTED_STATE:Withdraw",
      "description": "An application is withdrawn here only before it is accepted.",
      "action": "Withdraw",
      "states": [
        "Lodged"
      ]
    },
    {
      "id": "refused-final",
      "kind": "state_final",
      "code": "FINAL_STATE_LEFT:PermitRefused",
      "description": "A refusal is final in this workflow; an appeal is a separate matter.",
      "state": "PermitRefused"
    },
    {
      "id": "completed-final",
      "kind": "state_final",
      "code": "FINAL_STATE_LEFT:Completed",
      "description": "A certified permit is closed.",
      "state": "Completed"
    },
    {
      "id": "withdrawn-final",
      "kind": "state_final",
      "code": "FINAL_STATE_LEFT:Withdrawn",
      "description": "A withdrawn application is closed.",
      "state": "Withdrawn"
    },
    {
      "id": "no-application-stuck",
      "kind": "can_reach_end",
      "code": "APPLICATION_STUCK",
      "description": "Every application can still be finished: certified, refused, withdrawn or lapsed. None is left in a dead end or a loop with no way out.",
      "states": [
        "Completed",
        "PermitRefused",
        "Withdrawn",
        "Lapsed"
      ]
    },
    {
      "id": "no-forbidden-effects",
      "kind": "forbidden_effects",
      "code": "EFFECT_POLICY:forbidden",
      "description": "No decision is made without written reasons, and no applicant's personal data is published.",
      "effects": [
        "DecisionWithoutReasons",
        "ApplicantDataPublished"
      ]
    },
    {
      "id": "runtime-evidence",
      "kind": "requires_evidence",
      "code": "EVIDENCE_REQUIRED:runtime_matrix",
      "description": "A change is reviewed with the runtime matrix.",
      "evidence": "runtime_matrix"
    }
  ],
  "meanings": [
    {
      "id": "permit_lapse",
      "label": "An issued permit lapses if work never starts",
      "supported": true,
      "consequences": [
        "The permit manager may lapse an issued permit whose work never started.",
        "Approval still needs a plan review."
      ],
      "transactions": [
        {
          "kind": "add_state",
          "state": "Lapsed",
          "after": "Issued"
        },
        {
          "kind": "add_transition",
          "id": "TR-LAPSE",
          "action": "LapsePermit",
          "from_state": "Issued",
          "to_state": "Lapsed",
          "role": "PermitManager"
        }
      ]
    },
    {
      "id": "fast_track_minor_works",
      "label": "Fast-track minor works without a plan review",
      "supported": false,
      "consequences": [
        "Approves straight from intake; blocked by this pack's law that every approval follows a plan review."
      ],
      "transactions": [
        {
          "kind": "add_transition",
          "id": "TR-FASTTRACK",
          "action": "FastTrackApprove",
          "from_state": "Registered",
          "to_state": "Approved",
          "role": "PermitManager"
        }
      ]
    },
    {
      "id": "hold_application",
      "label": "Put an application on hold during review",
      "supported": false,
      "consequences": [
        "The reviewer parks an application on hold, but no step takes it off hold; blocked by this pack's law that every application can still be finished."
      ],
      "transactions": [
        {
          "kind": "add_state",
          "state": "OnHold",
          "after": "InReview"
        },
        {
          "kind": "add_transition",
          "id": "TR-HOLD",
          "action": "HoldApplication",
          "from_state": "InReview",
          "to_state": "OnHold",
          "role": "PlanReviewer"
        }
      ]
    },
    {
      "id": "unsupported",
      "label": "Outside the modelled scope",
      "supported": false,
      "consequences": [
        "Requires domain and source-level engineering; no automatic application."
      ]
    }
  ],
  "language": {
    "terms": [
      {
        "id": "application",
        "label": "Application",
