    "demo_request": "Let the permit manager lapse an issued permit when work never starts.",
    "proposals": {
      "summary": "Deterministic demonstration; no model inference was used.",
      "rules": [
        {
          "all": [],
          "any": [
            "fast",
            "minor",
            "skip review",
            "without a plan review"
          ],
          "alternatives": [
            {
              "interpretation": "fast_track_minor_works",
              "explanation": "Approval straight from intake. The pack's law that every approval follows a plan review blocks this."
            }
          ]
        },
        {
          "all": [],
          "any": [
            "lapse",
            "expire",
            "never start"
          ],
          "alternatives": [
            {
              "interpretation": "permit_lapse",
              "explanation": "The manager may lapse an issued permit whose work never started."
            }
          ]
        },
        {
          "all": [],
          "any": [
            "on hold",
            "park",
            "pause"
          ],
          "alternatives": [
            {
              "interpretation": "hold_application",
              "explanation": "Parks an application with no way back. The pack's law that every application can still be finished blocks this."
            }
          ]
        }
      ],
      "fallback": [
        {
          "interpretation": "unsupported",
          "explanation": "This offline fixture only demonstrates fast-tracking, lapsing and putting an application on hold."
        }
      ],
      "unknowns": [
        "Statutory decision deadlines and the clock stopping while information is requested are not modelled.",
        "Appeals are a separate workflow, not modelled.",
        "Reviewer comprehension has not been measured."
      ]
    }
