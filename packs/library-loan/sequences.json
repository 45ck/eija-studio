{
  "schema_version": "eija.sequences.v1",
  "id": "library-loan",
  "sequences": [
    {
      "id": "lend-and-return",
      "title": "Lend a book and get it back",
      "records": ["loan"],
      "steps": [
        {"actor": "librarian-assigned", "action": "CheckOut"},
        {"fragment": "alt", "operands": [
          {"guard": "returned on time", "steps": [
            {"actor": "librarian-assigned", "action": "Return"}
          ]},
          {"guard": "kept too long", "steps": [
            {"actor": "clerk", "action": "MarkOverdue"},
            {"actor": "librarian-assigned", "action": "ReturnLate"}
          ]}
        ]}
      ]
    },
    {
      "id": "who-may-lend",
      "title": "Only an assigned, active librarian lends",
      "records": ["loan"],
      "steps": [
        {"fragment": "neg", "refused": "ROLE_DENIED", "operands": [{"guard": "a member lends to themselves", "steps": [
          {"actor": "member-a", "action": "CheckOut"}
        ]}]},
        {"fragment": "neg", "refused": "ASSIGNMENT_DENIED", "operands": [{"guard": "not assigned to the branch", "steps": [
          {"actor": "librarian-unassigned", "action": "CheckOut"}
        ]}]},
        {"fragment": "neg", "refused": "ACTOR_REVOKED", "operands": [{"guard": "access revoked", "steps": [
          {"actor": "librarian-revoked", "action": "CheckOut"}
        ]}]},
        {"actor": "librarian-assigned", "action": "CheckOut"},
        {"fragment": "neg", "refused": "ROLE_DENIED", "operands": [{"guard": "a clerk takes the return", "steps": [
          {"actor": "clerk", "action": "Return"}
        ]}]}
      ]
    },
    {
      "id": "member-cancels",
      "title": "A member cancels a request",
      "records": ["loan"],
      "steps": [
        {"actor": "member-a", "action": "Cancel"},
        {"fragment": "neg", "refused": "STATE_DENIED", "operands": [{"guard": "lend a cancelled request", "steps": [
          {"actor": "librarian-assigned", "action": "CheckOut"}
        ]}]}
      ]
    }
  ]
}
