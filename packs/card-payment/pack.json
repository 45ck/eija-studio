        "active": false,
        "assigned": true
      }
    ],
    "demo_request": "Let customers take back a refund request.",
    "proposals": {
      "summary": "Deterministic demonstration; no model inference was used.",
      "rules": [
        {
          "all": [
            "refund"
          ],
          "any": [
            "support-agent",
            "agent",
            "withdraw",
            "take back",
            "cancel"
          ],
          "alternatives": [
            {
              "interpretation": "support_issues_refunds",
              "explanation": "Support would move money. The pack's laws block this: only finance approves a refund."
            },
            {
              "interpretation": "withdraw_refund_request",
              "explanation": "A customer may withdraw their own refund request; only finance still approves refunds."
            }
          ]
        }
      ],
      "fallback": [
        {
          "interpretation": "unsupported",
          "explanation": "This offline fixture only demonstrates refund authority."
        }
      ],
      "unknowns": [
        "Refund amounts and partial refunds are not modelled.",
        "Authorisation expiry (a hold lapses after days) is not modelled.",
        "Reviewer comprehension has not been measured."
      ]
    }
  },
