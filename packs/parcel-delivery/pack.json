    {
      "kind": "tlc",
      "mode": "not_run",
      "reason": "Generating TLA+ laws is deferred (docs/engineering/FUTURE-WORK.md)."
    }
  ],
  "journey": {
    "questions": [
      {
        "id": "deliver_authority",
        "question": "Who may deliver a parcel?",
        "expected": "Driver"
      },
      {
        "id": "delivered_entry",
        "question": "Which state must a parcel pass through before it is delivered?",
        "expected": "AtHub"
      }
    ]
  }
