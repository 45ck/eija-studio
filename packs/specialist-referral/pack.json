  ],
  "journey": {
    "questions": [
      {
        "id": "triage_authority",
        "question": "Who may triage a referral?",
        "expected": "TriageNurse"
      },
      {
        "id": "seen_entry",
        "question": "Which state must a referral pass through before the patient is seen?",
        "expected": "Vetted"
      }
    ]
  }
