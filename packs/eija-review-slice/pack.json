{
  "schema_version": "eija.pack.v1",
  "pack": {
    "id": "eija-review-slice",
    "name": "EIJA review reference journey",
    "version": "0.1.0",
    "description": "EIJA self-dogfood: a declared, synthetic review-path simulation with real source bindings. The source extractor reports observed syntax separately. This pack is NOT the full Studio lifecycle or a verified model of its implementation. Re-entry, layout/edit invalidation, discard, provider consent, exact-subject receipts and concurrent database gates need richer models. Pack effects are synthetic; changing this model does not modify EIJA source code."
  },
