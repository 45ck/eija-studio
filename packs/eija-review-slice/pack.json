        "action": "Propose",
        "from_state": "DRAFT",
        "to_state": "PROPOSED",
        "role": "Agent",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:ReferencePropose"
        ],
        "forbidden_effects": []
      },
      {
