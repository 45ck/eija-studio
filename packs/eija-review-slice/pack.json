          "state:PREVIEW"
        ]
      },
      {
        "id": "verify",
        "label": "Verify",
        "definition": "Reference-journey step linked to Studio.verify. The real method's conditions, failure paths and repeated calls remain visible as source facts and are not fully modeled here.",
        "binds": [
          "repo://src/eija_studio/application/service.py#Studio.verify"
