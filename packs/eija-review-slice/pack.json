  "meanings": [
    {
      "id": "show_saved_path",
      "label": "Show the optional saved-candidate path",
      "supported": true,
      "consequences": [
        "Adds SAVED as an optional reference-journey path.",
        "The implementation already supports save; no source code is changed.",
        "This synthetic workflow does not prove implementation conformance."
      ],
      "transactions": [
        {
          "kind": "add_state",
          "state": "SAVED"
        },
        {
          "kind": "add_transition",
          "id": "TR-SAVE",
          "action": "Save",
          "from_state": "PREVIEW",
          "to_state": "SAVED",
          "role": "Owner"
        },
        {
          "kind": "add_transition",
          "id": "TR-VERIFY-SAVED",
          "action": "VerifySaved",
          "from_state": "SAVED",
          "to_state": "VERIFIED",
          "role": "Agent"
        }
      ]
    },
    {
      "id": "agent_approval",
      "label": "Let the agent approve",
      "supported": false,
      "consequences": [
        "The reference law reserves approval for the owner; no automatic authority change."
      ],
      "transactions": [
        {
          "kind": "set_role",
          "transition": "TR-APPROVE",
          "role": "Agent"
        }
      ]
    },
    {
      "id": "unsupported",
      "label": "Outside this reference journey",
      "supported": false,
      "consequences": [
        "Requires source-level engineering and independent validation."
      ]
    }
  ],
  "language": {
    "terms": [
      {
        "id": "change-case",
        "label": "Change Case",
        "definition": "The implemented aggregate carries stage, candidate, selected meaning, receipts and decision. The displayed state graph is a declared reference path, not an exhaustive extraction of this aggregate.",
        "binds": [
          "repo://src/eija_studio/domain/change_case.py#ChangeCase"
        ],
        "refs": [
          "state:DRAFT"
        ]
      },
      {
        "id": "principal",
        "label": "Principal capability",
        "definition": "Principal.require checks named capabilities in real source. Pack roles and runtime actor guards are simulation data, not a replacement for this capability check.",
        "binds": [
          "repo://src/eija_studio/domain/models.py#Principal.require",
          "repo://src/eija_studio/domain/models.py#OWNER"
        ],
        "refs": [
          "role:Owner"
        ]
      },
      {
        "id": "review-subject",
        "label": "Exact review subject",
        "definition": "The real subject binds semantic, presentation, implementation, policy, environment and harness identity. These dimensions are not encoded by the finite reference journey.",
        "binds": [
          "repo://src/eija_studio/application/compiler.py#subject_for"
        ],
        "refs": []
      },
      {
        "id": "agent-surface",
        "label": "Agent tool surface",
        "definition": "Read the actual MCP tool declarations. An extracted allowlist is syntax evidence; it does not prove process isolation, registry conformance or protection against a process sharing owner OS permissions.",
        "binds": [
          "repo://src/eija_studio/interfaces/mcp_server.py#AGENT_TOOLS",
          "repo://src/eija_studio/interfaces/mcp_server.py#OWNER_ONLY_OPERATIONS",
          "repo://src/eija_studio/domain/models.py#AGENT"
        ],
        "refs": [
          "role:Agent"
        ]
      },
      {
        "id": "optimistic-version",
        "label": "Version comparison",
        "definition": "SQLite predicates compare the expected case and baseline versions before updating. The source facts preserve these predicates; this pack does not model database interleavings.",
        "binds": [
          "repo://src/eija_studio/adapters/sqlite_store.py#Session.save_case",
          "repo://src/eija_studio/adapters/sqlite_store.py#Session.set_active"
        ],
        "refs": []
      },
      {
        "id": "propose",
        "label": "Propose",
        "definition": "Reference-journey step linked to Studio.propose. The real method's conditions, failure paths and repeated calls remain visible as source facts and are not fully modeled here.",
        "binds": [
          "repo://src/eija_studio/application/service.py#Studio.propose"
        ],
        "refs": [
          "transition:TR-PROPOSE",
          "state:PROPOSED"
        ]
      },
      {
        "id": "select",
