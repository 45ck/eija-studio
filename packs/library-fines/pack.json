{
  "schema_version": "eija.pack.v1",
  "pack": {
    "id": "library-fines",
    "name": "Library fines",
    "version": "0.1.0",
    "description": "Fines the library issues on late, damaged or lost loans: a member pays or disputes, a librarian upholds or waives. It shares the Loan and Member classes with the library-loan workflow, so PlayIDE draws the two as one system."
  },
  "model": {
    "schema_version": "eija.workflow.v1",
    "id": "library-fines",
    "initial_state": "Issued",
    "states": [
      "Issued",
      "Paid",
      "Disputed",
      "Waived"
    ],
    "transitions": [
      {
        "id": "TR-PAY",
        "action": "Pay",
        "from_state": "Issued",
        "to_state": "Paid",
        "role": "Member",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:FinePaid"
        ],
        "forbidden_effects": [
          "FineWaivedSilently"
        ]
      },
      {
        "id": "TR-DISPUTE",
        "action": "Dispute",
        "from_state": "Issued",
        "to_state": "Disputed",
        "role": "Member",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:FineDisputed"
        ],
        "forbidden_effects": [
          "FineWaivedSilently"
        ]
      },
      {
        "id": "TR-UPHOLD",
        "action": "Uphold",
        "from_state": "Disputed",
        "to_state": "Issued",
        "role": "Librarian",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:FineUpheld",
          "Notification:MemberNotified"
        ],
        "forbidden_effects": [
          "FineWaivedSilently"
        ]
      },
      {
        "id": "TR-CONCEDE",
        "action": "Concede",
        "from_state": "Disputed",
        "to_state": "Waived",
        "role": "Librarian",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:DisputeConceded",
          "Notification:MemberNotified"
        ],
        "forbidden_effects": [
          "FineWaivedSilently"
        ]
      },
      {
        "id": "TR-WAIVE",
        "action": "Waive",
        "from_state": "Issued",
        "to_state": "Waived",
        "role": "Librarian",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:FineWaived",
          "Notification:MemberNotified"
        ],
        "forbidden_effects": [
          "FineWaivedSilently"
        ]
      }
    ]
  },
