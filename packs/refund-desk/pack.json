{
  "schema_version": "eija.pack.v1",
  "pack": {
    "id": "refund-desk",
    "name": "Refund desk",
    "version": "1.0.0",
    "description": "A support desk where an AI agent triages refund requests and proposes refunds, a timer escalates the ones nobody decided, a payment system reports the payout, and only a person approves. It shows actors that are not people (ADR-0210): laws about the kind of actor keep a human in the loop whatever the agent is given."
  },
  "model": {
    "schema_version": "eija.workflow.v1",
    "id": "refund-desk",
    "initial_state": "Requested",
    "states": [
      "Requested",
      "Assessed",
      "AwaitingApproval",
      "WithSupervisor",
      "Approved",
      "Paid",
      "PayoutFailed",
      "Declined",
      "Withdrawn"
    ],
    "transitions": [
      {
        "id": "TR-TRIAGE",
        "action": "AssessRequest",
        "from_state": "Requested",
        "to_state": "Assessed",
        "role": "SupportAgent",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:RefundTriaged"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-WITHDRAW",
        "action": "Withdraw",
        "from_state": "Requested",
        "to_state": "Withdrawn",
        "role": "Customer",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:RequestWithdrawn"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-PROPOSE",
        "action": "ProposeRefund",
        "from_state": "Assessed",
        "to_state": "AwaitingApproval",
        "role": "SupportAgent",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:RefundProposed",
          "Notification:SupervisorAsked"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-APPROVE",
        "action": "ApproveRefund",
        "from_state": "AwaitingApproval",
        "to_state": "Approved",
        "role": "Supervisor",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding",
          "actor_assigned"
        ],
        "required_effects": [
          "Audit:RefundApproved"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-DECLINE",
        "action": "DeclineRefund",
        "from_state": "AwaitingApproval",
        "to_state": "Declined",
        "role": "Supervisor",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:RefundDeclined",
          "Notification:CustomerToldDeclined"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-ESCALATE",
        "action": "EscalateStale",
        "from_state": "AwaitingApproval",
        "to_state": "WithSupervisor",
        "role": "SlaTimer",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:RefundEscalated",
          "Notification:SupervisorPaged"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-RESOLVE",
        "action": "ResolveEscalation",
        "from_state": "WithSupervisor",
        "to_state": "Approved",
        "role": "Supervisor",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding",
          "actor_assigned"
        ],
        "required_effects": [
          "Audit:EscalationResolved"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-DISMISS",
        "action": "DismissEscalation",
        "from_state": "WithSupervisor",
        "to_state": "Declined",
        "role": "Supervisor",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:EscalationDismissed",
          "Notification:CustomerToldDeclined"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-CONFIRM",
        "action": "ConfirmPayout",
        "from_state": "Approved",
        "to_state": "Paid",
        "role": "PaymentGateway",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:RefundPaid",
          "Notification:CustomerToldPaid"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-FAIL",
        "action": "FailPayout",
        "from_state": "Approved",
        "to_state": "PayoutFailed",
        "role": "PaymentGateway",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:PayoutFailed"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      },
      {
        "id": "TR-RETRY",
        "action": "RetryPayout",
        "from_state": "PayoutFailed",
        "to_state": "Approved",
        "role": "Supervisor",
        "guards": [
          "actor_active",
          "role_current",
          "state_equals",
          "expected_version",
          "operation_binding"
        ],
        "required_effects": [
          "Audit:PayoutRetried"
        ],
        "forbidden_effects": [
          "CardDataSentToModel",
          "RefundSentUnapproved"
        ]
      }
    ]
  },
  "roles": [
    {
      "id": "Customer",
      "description": "Asks for a refund; may withdraw a request nobody has picked up."
    },
    {
      "id": "SupportAgent",
      "kind": "agent",
      "description": "An AI agent: triages requests and proposes a refund. It never decides one."
    },
    {
      "id": "Supervisor",
      "description": "A person on the support desk: approves or declines a proposed refund when on shift (assigned)."
    },
    {
      "id": "SlaTimer",
      "kind": "timer",
      "description": "A scheduled job: escalates a proposal nobody decided within the service level."
    },
    {
      "id": "PaymentGateway",
      "kind": "system",
      "description": "The external payment system: calls back when a payout settles or fails."
    }
  ],
  "actions": [
    {
      "id": "AssessRequest",
      "guards": [
        "actor_active",
        "role_current",
        "state_equals",
        "expected_version",
        "operation_binding"
      ],
      "required_effects": [
        "Audit:RefundTriaged"
      ]
    },
    {
      "id": "Withdraw",
      "guards": [
        "actor_active",
        "role_current",
        "state_equals",
        "expected_version",
        "operation_binding"
      ],
      "required_effects": [
