    "demo_request": "Let the support agent approve refunds itself.",
    "proposals": {
      "summary": "Deterministic demonstration; no model inference was used.",
      "rules": [
        {
          "all": [
            "agent"
          ],
          "any": [
            "approve",
            "decide",
            "itself",
            "hand",
            "escalate",
            "unsure"
          ],
          "alternatives": [
            {
              "interpretation": "agent_hands_off",
              "explanation": "The agent hands requests it cannot settle to a supervisor; a person still approves every refund."
            },
            {
              "interpretation": "agent_auto_approve",
              "explanation": "Would let the agent approve refunds itself. The pack's laws keep that decision with a person."
            }
          ]
        }
      ],
      "fallback": [
        {
          "interpretation": "unsupported",
          "explanation": "This offline fixture only demonstrates the agent's hand-off."
        }
      ],
      "unknowns": [
        "Actual refund policy and amounts are unknown; the kernel has no value guards yet (issue #93).",
        "Timer behaviour is modelled as a scheduled actor, not as elapsed time."
      ]
    }
