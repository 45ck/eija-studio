  },
  "laws": [
    {
      "id": "only-people-approve",
      "kind": "only_kind_holds",
      "code": "HUMAN_DECISION:ApproveRefund",
      "role_kinds": [
        "human"
      ],
      "action": "ApproveRefund",
      "description": "Only a person approves a refund: no AI agent, timer or external system holds that decision."
    },
    {
      "id": "only-people-resolve",
      "kind": "only_kind_holds",
      "code": "HUMAN_DECISION:ResolveEscalation",
      "role_kinds": [
        "human"
      ],
      "action": "ResolveEscalation",
      "description": "Only a person resolves an escalation."
    },
    {
      "id": "approved-by-people",
      "kind": "only_kind_enters",
      "code": "HUMAN_DECISION:Approved",
      "role_kinds": [
        "human"
      ],
      "state": "Approved",
      "description": "Only a person moves a refund into Approved, by any action."
    },
    {
      "id": "person-in-the-loop",
      "kind": "path_requires_kind",
      "code": "HUMAN_IN_THE_LOOP:Paid",
      "role_kinds": [
        "human"
      ],
      "state": "Paid",
      "description": "Every refund that is paid had a person act on it first: no run is agents and machines alone."
    },
    {
      "id": "payout-confirmed-by-gateway",
      "kind": "only_kind_holds",
      "code": "PROTECTED_AUTHORITY:ConfirmPayout",
      "role_kinds": [
        "system"
      ],
      "action": "ConfirmPayout",
      "description": "Only the payment system confirms a payout: nobody marks a refund paid by hand."
    },
    {
      "id": "paid-requires-approval",
      "kind": "path_requires",
      "code": "REFUND_PAID_WITHOUT_APPROVAL",
      "state": "Paid",
      "via": "Approved",
      "description": "Every path to Paid passes through Approved."
    },
    {
      "id": "paid-final",
      "kind": "state_final",
      "code": "FINAL_STATE_LEFT:Paid",
      "state": "Paid",
      "description": "A paid refund is closed."
    },
    {
      "id": "declined-final",
      "kind": "state_final",
      "code": "FINAL_STATE_LEFT:Declined",
      "state": "Declined",
      "description": "A declined refund is closed."
    },
    {
      "id": "withdrawn-final",
      "kind": "state_final",
      "code": "FINAL_STATE_LEFT:Withdrawn",
      "state": "Withdrawn",
      "description": "A withdrawn request is closed."
    },
    {
      "id": "withdraw-before-triage",
      "kind": "action_source_in",
      "code": "PROTECTED_STATE:Withdraw",
      "action": "Withdraw",
      "states": [
        "Requested"
      ],
      "description": "A customer withdraws only a request nobody has picked up."
    },
    {
      "id": "approve-on-shift",
      "kind": "action_requires_guard",
      "code": "GUARD_POLICY:ApproveRefund",
      "action": "ApproveRefund",
      "guards": [
        "actor_assigned"
      ],
      "description": "Approving needs the supervisor to be on shift (assigned)."
    },
    {
      "id": "no-card-data-to-model",
      "kind": "forbidden_effects",
      "code": "EFFECT_POLICY:forbidden",
      "effects": [
        "CardDataSentToModel",
        "RefundSentUnapproved"
      ],
      "description": "No step sends card data to a model or pays a refund nobody approved."
    },
    {
      "id": "runtime-evidence",
      "kind": "requires_evidence",
      "code": "EVIDENCE_REQUIRED:runtime_matrix",
      "evidence": "runtime_matrix",
      "description": "A change is reviewed with the runtime matrix."
    }
  ],
  "meanings": [
    {
      "id": "agent_hands_off",
      "label": "The agent hands unclear requests to a supervisor",
      "supported": true,
      "consequences": [
        "The AI agent may escalate a triaged request straight to a person instead of proposing a refund.",
        "A person still approves every refund that is paid.",
        "The agent gains no deciding authority."
      ],
      "transactions": [
        {
          "kind": "add_transition",
          "id": "TR-HANDOFF",
          "action": "HandOff",
          "from_state": "Assessed",
          "to_state": "WithSupervisor",
          "role": "SupportAgent"
        }
      ]
    },
    {
      "id": "agent_auto_approve",
      "label": "The agent approves refunds itself",
      "supported": false,
      "consequences": [
        "Takes the person out of the loop; blocked by this pack's laws about who decides."
      ],
      "transactions": [
        {
          "kind": "set_role",
          "transition": "TR-APPROVE",
          "role": "SupportAgent"
        }
      ]
    },
    {
      "id": "unsupported",
      "label": "Outside the modelled scope",
      "supported": false,
      "consequences": [
        "Requires domain and source-level engineering; no automatic application."
      ]
    }
  ],
  "language": {
    "terms": [
      {
        "id": "refund",
        "label": "Refund",
        "definition": "Money returned to one customer for one order; the workflow instance.",
        "binds": [
          "repo://packs/refund-desk/pack.json"
        ],
        "refs": [
          "state:Paid"
        ]
      },
      {
        "id": "support-agent",
        "label": "Support agent",
        "definition": "The AI agent on the desk. It triages and proposes; a person decides.",
        "binds": [
          "repo://packs/refund-desk/pack.json"
        ],
        "refs": [
          "role:SupportAgent",
          "law:only-people-approve"
        ]
      },
      {
        "id": "escalation",
        "label": "Escalation",
        "definition": "A proposal nobody decided in time, put in front of a supervisor by the service-level timer.",
        "binds": [
          "repo://packs/refund-desk/pack.json"
        ],
        "refs": [
          "state:WithSupervisor",
          "transition:TR-ESCALATE"
        ]
      },
      {
        "id": "human-in-the-loop",
        "label": "Person in the loop",
        "definition": "A person acts on every refund before it is paid.",
        "binds": [
          "repo://packs/refund-desk/pack.json"
        ],
        "refs": [
          "law:person-in-the-loop"
        ]
      }
    ]
  },
